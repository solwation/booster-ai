<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.ImportProjectsWindow"
        x:DataType="local:ImportViewModel"
        Title="{local:T import.title}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="720" Height="560" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner">

  <!-- Columns: check 36 · name/path/orchestra status * · kind 90. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="28,22,28,20">

    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
      <TextBlock Classes="title" Text="{local:T import.heading}" />
      <TextBlock Classes="muted" Text="{Binding Hint}" TextWrapping="Wrap" />
    </StackPanel>

    <Panel Grid.Row="1">
      <local:ProjectPickList IsVisible="{Binding HasItems}" />

      <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding IsScanning}" />
        <TextBlock Classes.muted="{Binding !MessageIsError}" Classes.error="{Binding MessageIsError}" Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
      </StackPanel>
    </Panel>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0" Click="OnPickRoot" Padding="12,8" ToolTip.Tip="{local:T import.root.tip}" IsEnabled="{Binding !IsScanning}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource FolderIcon}" Width="15" Height="13" Stretch="Uniform" StrokeThickness="1.4"
                StrokeJoin="Round" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{local:T import.root}" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button Content="{local:T cancel}" Click="OnCancel" IsCancel="True" Padding="18,8" />
        <Button Classes="primary" Click="OnImport" IsDefault="True" Padding="18,8"
                Content="{Binding ImportLabel}" IsEnabled="{Binding CanImport}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.ConfirmRestartWindow"
        x:DataType="local:ConfirmRestartWindow"
        Title="{local:T restartConfirm.title}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="28,24,28,22" Spacing="14">
    <TextBlock Classes="title" FontSize="20" TextWrapping="Wrap" Text="{Binding Heading}" />
    <TextBlock TextWrapping="Wrap" LineHeight="21" Text="{Binding Body}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="20" Text="{Binding Detail}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
      <Button Content="{local:T cancel}" Click="OnCancel" IsCancel="True" Padding="18,8" />
      <Button Content="{local:T restartConfirm.now}" Click="OnNow" Padding="18,8" />
      <Button Classes="accent" Content="{local:T restartConfirm.whenIdle}" Click="OnWhenIdle" IsDefault="True" Padding="18,8"
              IsVisible="{Binding CanWait}" />
    </StackPanel>
  </StackPanel>
</Window>

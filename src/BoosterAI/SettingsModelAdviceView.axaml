<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BoosterAI"
             x:Class="BoosterAI.SettingsModelAdviceView" x:DataType="local:SettingsModelAdviceViewModel">
  <Border Classes="agent-group">
    <StackPanel Spacing="9">
      <TextBlock Text="{local:T settingsAdvice.title}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ModelContext}" IsVisible="{Binding HasModelContext}" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="{Binding HardwareSummary}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" FontSize="12" />
      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" IsEnabled="{Binding Exact.CanCheck}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{local:T settingsAdvice.profileLabel}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="local:PlanningModelProfile"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Spacing="4" IsVisible="{Binding HasProfile}">
        <TextBlock Text="{Binding ProfileEvidence}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        <Button Classes="link" Content="{local:T settingsAdvice.profileSource}" Click="OnProfileSource" HorizontalAlignment="Left" />
      </StackPanel>
      <Expander Header="{local:T settingsAdvice.hardwareDetails}">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="{Binding HardwareDetails}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{local:T localAdvice.platform}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{local:T settingsAdvice.measurementScope}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Expander>
      <Expander Header="{local:T settingsAdvice.exact}">
        <StackPanel x:DataType="local:LocalModelViewModel" DataContext="{Binding Exact}" Spacing="7" Margin="0,8,0,0">
          <TextBlock Text="{local:T settingsAdvice.exactHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{local:T localAdvice.model}" TextWrapping="Wrap" FontSize="12" />
          <TextBox Text="{Binding Model}" AutomationProperties.Name="{local:T localAdvice.model}" IsEnabled="{Binding CanCheck}" />
          <TextBlock Text="{local:T localAdvice.endpoint}" TextWrapping="Wrap" FontSize="12" />
          <TextBox Text="{Binding Endpoint}" AutomationProperties.Name="{local:T localAdvice.endpoint}" IsEnabled="{Binding CanCheck}" />
          <CheckBox IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanCheck}"><TextBlock Text="{local:T localAdvice.confirm}" TextWrapping="Wrap" /></CheckBox>
          <CheckBox IsChecked="{Binding CpuOnly}" IsEnabled="{Binding CanCheck}"><TextBlock Text="{local:T localAdvice.cpuOnly}" TextWrapping="Wrap" /></CheckBox>
          <Button Content="{local:T settingsAdvice.checkExact}" Click="OnCheckExact" IsEnabled="{Binding CanCheck}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{Binding Metadata}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>

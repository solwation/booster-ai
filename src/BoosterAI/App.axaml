<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoosterAI.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
    <!-- One family for the interface, its mono sibling for paths, models and commands. -->
    <FontFamily x:Key="UiFont">avares://BoosterAI/Assets/Fonts#IBM Plex Sans</FontFamily>
    <!-- Plex Mono has Latin only. BoosterAI Symbols (bundled) carries the box drawing, arrows and dingbats the agent CLIs
         print, plus U+23BF, U+23FA and U+23F5, which no common monospace font has; the system fonts come last. -->
    <FontFamily x:Key="MonoFont">avares://BoosterAI/Assets/Fonts#IBM Plex Mono, avares://BoosterAI/Assets/Fonts#BoosterAI Symbols, Cascadia Mono, Consolas, DejaVu Sans Mono</FontFamily>
    <BoxShadows x:Key="PopupShadow">0 8 24 0 #2E000000</BoxShadows>

    <!-- Accent from the icon's bolt gradient (#1E66F5 → #8839EF), midpoint. -->
    <Color x:Key="SystemAccentColor">#5B5FF2</Color>
    <Color x:Key="SystemAccentColorDark1">#4C4FDB</Color>
    <Color x:Key="SystemAccentColorDark2">#3E40C0</Color>
    <Color x:Key="SystemAccentColorDark3">#3032A3</Color>
    <Color x:Key="SystemAccentColorLight1">#7477F5</Color>
    <Color x:Key="SystemAccentColorLight2">#9093F7</Color>
    <Color x:Key="SystemAccentColorLight3">#ABAEFA</Color>

    <!-- Design tokens for both themes (Avalonia's Fluent has no WinUI text-fill brushes). Status and error
         colours live only here: text tokens reach 4.5:1 on BackgroundBrush and SurfaceBrush, *Dot tokens are for
         status dots. BorderBrush is for decorative edges only; field edges use FieldBorderBrush (>= 3:1). -->
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9ADBC" />
        <SolidColorBrush x:Key="FaintBrush" Color="#8A8EA0" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="LinkBrush" Color="#9A9DFF" />
        <SolidColorBrush x:Key="LinkHoverBrush" Color="#BDBFFF" />
        <SolidColorBrush x:Key="RecommendedBrush" Color="#5BC26E" />

        <SolidColorBrush x:Key="BackgroundBrush" Color="#14151B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1E26" />
        <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#262935" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343846" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#70758A" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#5BC26E" />
        <SolidColorBrush x:Key="SuccessDotBrush" Color="#46A758" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6F" />
        <SolidColorBrush x:Key="DangerDotBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E8A93A" />
        <SolidColorBrush x:Key="WarningDotBrush" Color="#D08A1E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#6FA4F0" />
        <SolidColorBrush x:Key="InfoDotBrush" Color="#3B7DD8" />
        <SolidColorBrush x:Key="NeutralStatusBrush" Color="#8A8FA0" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2A1518" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#2A2112" />
        <SolidColorBrush x:Key="DangerFillBrush" Color="#C62F35" />
        <SolidColorBrush x:Key="DangerFillHoverBrush" Color="#A8262C" />
        <SolidColorBrush x:Key="DangerFillPressedBrush" Color="#8F2025" />
        <SolidColorBrush x:Key="PrimaryFillBrush" Color="#5B5FF2" />
        <SolidColorBrush x:Key="PrimaryFillHoverBrush" Color="#4C4FDB" />
        <SolidColorBrush x:Key="PrimaryFillPressedBrush" Color="#3E40C0" />
        <!-- Inactive buttons of every variant: no fill, FieldBorderBrush at 50 % opacity, FaintBrush text. -->
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#8070758A" />

        <!-- Fluent keys mapped onto the tokens above (same values; keep them in step). -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#262935" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#343846" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C1E26" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#00000000" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#343846" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#343846" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#343846" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#8070758A" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8A8EA0" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="#1C1E26" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#343846" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#14151B" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1C1E26" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#262935" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#1C1E26" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#70758A" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#70758A" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1C1E26" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#343846" />
        <SolidColorBrush x:Key="TextControlBackground" Color="#14151B" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1C1E26" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#70758A" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#70758A" />
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#1C1E26" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#262935" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#262935" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#343846" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1C1E26" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#343846" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="TextBrush" Color="#1B1D26" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A5E6E" />
        <SolidColorBrush x:Key="FaintBrush" Color="#6B6F80" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#0C000000" />
        <SolidColorBrush x:Key="LinkBrush" Color="#3B3FCF" />
        <SolidColorBrush x:Key="LinkHoverBrush" Color="#2A2DA8" />
        <SolidColorBrush x:Key="RecommendedBrush" Color="#27773A" />

        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F6F9" />
        <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#ECEEF3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE5" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#80859A" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#27773A" />
        <SolidColorBrush x:Key="SuccessDotBrush" Color="#2E9E5B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C62F35" />
        <SolidColorBrush x:Key="DangerDotBrush" Color="#D2453F" />
        <SolidColorBrush x:Key="WarningBrush" Color="#9A6200" />
        <SolidColorBrush x:Key="WarningDotBrush" Color="#D08A1E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#2F6FD0" />
        <SolidColorBrush x:Key="InfoDotBrush" Color="#3B7DD8" />
        <SolidColorBrush x:Key="NeutralStatusBrush" Color="#8A8FA0" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FDF0F0" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FDF4E3" />
        <SolidColorBrush x:Key="DangerFillBrush" Color="#C62F35" />
        <SolidColorBrush x:Key="DangerFillHoverBrush" Color="#A8262C" />
        <SolidColorBrush x:Key="DangerFillPressedBrush" Color="#8F2025" />
        <SolidColorBrush x:Key="PrimaryFillBrush" Color="#5B5FF2" />
        <SolidColorBrush x:Key="PrimaryFillHoverBrush" Color="#4C4FDB" />
        <SolidColorBrush x:Key="PrimaryFillPressedBrush" Color="#3E40C0" />
        <!-- Inactive buttons of every variant: no fill, FieldBorderBrush at 50 % opacity, FaintBrush text. -->
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#8080859A" />

        <!-- Fluent keys mapped onto the tokens above (same values; keep them in step). -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#ECEEF3" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#8080859A" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B6F80" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#ECEEF3" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#80859A" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#80859A" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D9DCE5" />
        <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F5F6F9" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#80859A" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#80859A" />
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#ECEEF3" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#ECEEF3" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#D9DCE5" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="#F5F6F9" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#D9DCE5" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>

    <LinearGradientBrush x:Key="BoostBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#1E66F5" />
      <GradientStop Offset="1" Color="#8839EF" />
    </LinearGradientBrush>

    <StreamGeometry x:Key="FolderIcon">M1.5,3.5 C1.5,2.95 1.95,2.5 2.5,2.5 L6,2.5 L7.5,4 L13.5,4 C14.05,4 14.5,4.45 14.5,5 L14.5,12.5 C14.5,13.05 14.05,13.5 13.5,13.5 L2.5,13.5 C1.95,13.5 1.5,13.05 1.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="OpenExternalIcon">M9,2 L14,2 L14,7 M14,2 L7.5,8.5 M12,9.5 L12,14 L2,14 L2,4 L6.5,4</StreamGeometry>
    <StreamGeometry x:Key="CloseIcon">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
    <StreamGeometry x:Key="PlusIcon">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
    <StreamGeometry x:Key="GearIcon">M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 Z M8,1.5 L8,3 M8,13 L8,14.5 M1.5,8 L3,8 M13,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M3.4,12.6 L4.5,11.5 M11.5,4.5 L12.6,3.4</StreamGeometry>
    <StreamGeometry x:Key="RestartIcon">M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.5,1.5 L12.5,4.5 L9.5,4.5</StreamGeometry>
    <StreamGeometry x:Key="DownloadIcon">M8,1.5 L8,10 M4.5,6.5 L8,10 L11.5,6.5 M2,13.5 L14,13.5</StreamGeometry>
    <StreamGeometry x:Key="ShieldIcon">M8,1.5 L13.5,3.5 L13.5,8 C13.5,11 11,13.5 8,14.5 C5,13.5 2.5,11 2.5,8 L2.5,3.5 Z M5.5,8 L7.3,9.8 L10.5,6.5</StreamGeometry>
    <StreamGeometry x:Key="WarningIcon">M8,1.8 L14.6,13.6 L1.4,13.6 Z M8,6.2 L8,9.6 M8,11.6 L8,11.7</StreamGeometry>
    <StreamGeometry x:Key="BoltIcon">M9.4,1 L3,9.2 L7.4,9.2 L6.4,15 L13,6.6 L8.6,6.6 Z</StreamGeometry>
    <!-- Stroked status marks (16 px box): result cards and the server check in Local models. -->
    <StreamGeometry x:Key="CheckIcon">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
    <StreamGeometry x:Key="ErrorIcon">M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 Z M5.6,5.6 L10.4,10.4 M10.4,5.6 L5.6,10.4</StreamGeometry>
      </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://BoosterAI/Styles.axaml" />
  </Application.Styles>
</Application>

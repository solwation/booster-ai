<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoosterAI.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
    <!-- One family for the interface, its mono sibling for paths, models and commands. -->
    <FontFamily x:Key="UiFont">avares://BoosterAI/Assets/Fonts#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="MonoFont">avares://BoosterAI/Assets/Fonts#IBM Plex Mono</FontFamily>

    <!-- Accent from the icon's bolt gradient (#1E66F5 → #8839EF), midpoint. -->
    <Color x:Key="SystemAccentColor">#5B5FF2</Color>
    <Color x:Key="SystemAccentColorDark1">#4C4FDB</Color>
    <Color x:Key="SystemAccentColorDark2">#3E40C0</Color>
    <Color x:Key="SystemAccentColorDark3">#3032A3</Color>
    <Color x:Key="SystemAccentColorLight1">#7477F5</Color>
    <Color x:Key="SystemAccentColorLight2">#9093F7</Color>
    <Color x:Key="SystemAccentColorLight3">#ABAEFA</Color>

    <!-- Text and surface tones for both themes (Avalonia's Fluent has no WinUI text-fill brushes). -->
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9ADBC" />
        <SolidColorBrush x:Key="FaintBrush" Color="#7C8091" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="LinkBrush" Color="#9A9DFF" />
        <SolidColorBrush x:Key="LinkHoverBrush" Color="#BDBFFF" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="TextBrush" Color="#1B1D26" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A5E6E" />
        <SolidColorBrush x:Key="FaintBrush" Color="#7F8394" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#0C000000" />
        <SolidColorBrush x:Key="LinkBrush" Color="#3B3FCF" />
        <SolidColorBrush x:Key="LinkHoverBrush" Color="#2A2DA8" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <LinearGradientBrush x:Key="BoostBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#1E66F5" />
      <GradientStop Offset="1" Color="#8839EF" />
    </LinearGradientBrush>

    <StreamGeometry x:Key="FolderIcon">M1.5,3.5 C1.5,2.95 1.95,2.5 2.5,2.5 L6,2.5 L7.5,4 L13.5,4 C14.05,4 14.5,4.45 14.5,5 L14.5,12.5 C14.5,13.05 14.05,13.5 13.5,13.5 L2.5,13.5 C1.95,13.5 1.5,13.05 1.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="OpenExternalIcon">M9,2 L14,2 L14,7 M14,2 L7.5,8.5 M12,9.5 L12,14 L2,14 L2,4 L6.5,4</StreamGeometry>
    <StreamGeometry x:Key="CloseIcon">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
    <StreamGeometry x:Key="PlusIcon">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
    <StreamGeometry x:Key="GearIcon">M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 Z M8,1.5 L8,3 M8,13 L8,14.5 M1.5,8 L3,8 M13,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M3.4,12.6 L4.5,11.5 M11.5,4.5 L12.6,3.4</StreamGeometry>
    <StreamGeometry x:Key="RestartIcon">M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.5,1.5 L12.5,4.5 L9.5,4.5</StreamGeometry>
    <StreamGeometry x:Key="DownloadIcon">M8,1.5 L8,10 M4.5,6.5 L8,10 L11.5,6.5 M2,13.5 L14,13.5</StreamGeometry>
    <StreamGeometry x:Key="ShieldIcon">M8,1.5 L13.5,3.5 L13.5,8 C13.5,11 11,13.5 8,14.5 C5,13.5 2.5,11 2.5,8 L2.5,3.5 Z M5.5,8 L7.3,9.8 L10.5,6.5</StreamGeometry>
    <StreamGeometry x:Key="BoltIcon">M9.4,1 L3,9.2 L7.4,9.2 L6.4,15 L13,6.6 L8.6,6.6 Z</StreamGeometry>
      </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://BoosterAI/Styles.axaml" />
  </Application.Styles>
</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding AppTitle}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="1100" Height="560" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <!--
    Today's choices only: which tabs, and the AI, model and /orkester for each.
    Names and directories are edited in Settings. The header and the rows share
    one column layout (stripe 4 · drag handle 20 · check 36 · name * · status 200 · llm 132 · model 195 · orkester 110 · once 130)
    inside the same padding, so labels sit exactly over their fields.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="28,22,28,20">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <Image Grid.Column="0" Source="avares://BoosterAI/Assets/boosterai.png" Width="40" Height="40"
             VerticalAlignment="Center" Margin="0,0,14,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="title" Text="BoosterAI" />
        <TextBlock Classes="muted" Text="{local:T main.subtitle}" />
      </StackPanel>
      <Button Grid.Column="2" Classes="main-action" Click="OnSettings" Padding="12,8" AutomationProperties.Name="{local:T settings.button}" VerticalAlignment="Center"
              ToolTip.Tip="{local:T settings.tip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource GearIcon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
                StrokeLineCap="Round" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{local:T settings.button}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Update prompt: a quiet bar, only while a newer release is offered (see UpdateViewModel). -->
    <StackPanel Grid.Row="1">
    <Border Classes="update" IsVisible="{Binding Update.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Update.Text}" TextWrapping="Wrap" FontSize="13.5" Classes.failed="{Binding Update.Failed}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Update.HasSummary}">
            <TextBlock Text="{Binding Update.Summary}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12.5"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" ToolTip.Tip="{Binding Update.Summary}" />
            <Button Grid.Column="1" Classes="link" Click="OnUpdateMore" Margin="10,0,0,0" Padding="0"
                    ToolTip.Tip="{Binding Update.MoreUrl}" AutomationProperties.Name="{local:T update.more.name}">
              <TextBlock Text="{local:T update.more}" FontSize="12.5" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes="accent" Content="{local:T update.install}" Click="OnUpdateInstall" IsVisible="{Binding Update.ShowInstall}"
                  ToolTip.Tip="{Binding Update.InstallTip}" Padding="14,6" />
          <Button Classes="accent" Content="{local:T update.page}" Click="OnUpdatePage" IsVisible="{Binding Update.ShowPage}"
                  ToolTip.Tip="{Binding Update.PageUrl}" Padding="14,6" />
          <Button Content="{local:T update.later}" Click="OnUpdateLater" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
          <Button Content="{local:T update.skip}" Click="OnUpdateSkip" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Denied commands: agy refused a command in a Run once tab; offer allow-rules (see DenialViewModel). -->
    <Border Classes="update" IsVisible="{Binding Denial.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource ShieldIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding Denial.Text}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13.5" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes="accent" Content="{local:T denied.allow}" Click="OnAllowDenied" ToolTip.Tip="{Binding Denial.AllowTip}" Padding="14,6" />
          <Button Content="{local:T denied.dismiss}" Click="OnDismissDenied" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="4,20,36,*,200,132,195,110,130" Margin="0,0,0,6" IsVisible="{Binding HasTabs}">
      <TextBlock Grid.Column="2" Classes="colhead" Text="{local:T col.with}" />
      <TextBlock Grid.Column="3" Classes="colhead" Text="{local:T col.project}" />
      <TextBlock Grid.Column="4" Classes="colhead" Text="{local:T col.status}" />
      <TextBlock Grid.Column="5" Classes="colhead" Text="{local:T col.llm}" />
      <TextBlock Grid.Column="6" Classes="colhead" Text="{local:T col.model}" />
      <TextBlock Grid.Column="7" Classes="colhead" Text="{local:T col.orkester}" Margin="16,0,0,0" />
      <TextBlock Grid.Column="8" Classes="colhead" Text="{local:T col.once}" Margin="16,0,0,0" />
    </Grid>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TabViewModel">
              <Border Classes="row" DragDrop.AllowDrop="True" DragDrop.DragOver="OnTabDragOver"
                      DragDrop.DragLeave="OnTabDragLeave" DragDrop.Drop="OnTabDrop">
                <Grid ColumnDefinitions="4,20,36,*,200,132,195,110,130">
                  <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="2" />
                  <TextBlock Grid.Column="1" Text="⋮" Foreground="{DynamicResource FaintBrush}" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnTabDragStart"
                             ToolTip.Tip="{local:T tab.reorder.tip}" />

                  <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"
                            MinWidth="0" ToolTip.Tip="{local:T tab.open.tip}" />

                  <!-- The path is a hover tip on the name; the icon after it opens the folder. -->
                  <Grid Grid.Column="3" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Opacity="{Binding RowOpacity}" Margin="0,0,16,0">
                    <TextBlock Grid.Column="0" Classes="name" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Directory}" />
                    <Button Grid.Column="1" Classes="icon" Click="OnOpenFolder" Margin="6,-6,0,-6"
                            ToolTip.Tip="{local:T folder.open.tip}" AutomationProperties.Name="{local:T folder.open.name}">
                      <Path Data="{StaticResource OpenExternalIcon}" Width="12" Height="12" />
                    </Button>
                  </Grid>

                  <Grid Grid.Column="4" ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center"
                        Margin="0,0,12,0" IsVisible="{Binding HasStatus}" ClipToBounds="True">
                    <!-- Hovering the dot or text opens the status popup: the status tip and, while the CLI lives,
                         the tab's last lines, read every second while it is open (MainViewModel.WatchOutput). -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Background="Transparent"
                          ToolTip.ToolTipOpening="OnStatusTipOpening" ToolTip.ToolTipClosing="OnStatusTipClosing">
                      <ToolTip.Tip>
                        <ToolTip Classes="output">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding StatusTip}" TextWrapping="Wrap" MaxWidth="{x:Static local:TabOutputView.PopupWidth}" HorizontalAlignment="Left" />
                            <local:TabOutputView IsVisible="{Binding HasOutput}" />
                            <TextBlock Classes="muted" Text="{Binding OutputNote}" IsVisible="{Binding HasOutputNote}" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="{x:Static local:TabOutputView.PopupWidth}" HorizontalAlignment="Left" />
                          </StackPanel>
                        </ToolTip>
                      </ToolTip.Tip>
                      <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12.5" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Button Grid.Column="2" Classes="icon" Click="OnRestart" IsVisible="{Binding CanRestart}" Margin="7,-6,0,-6"
                            ToolTip.Tip="{Binding RestartTip}" AutomationProperties.Name="{local:T restart.name}">
                      <Path Data="{StaticResource RestartIcon}" Width="12" Height="12" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Click="OnContinue" IsVisible="{Binding CanContinueClosed}" Margin="4,-6,0,-6"
                            ToolTip.Tip="{Binding ContinueTip}" AutomationProperties.Name="{local:T restart.continue.name}">
                      <Path Data="M3,2 L13,8 L3,14 Z M1,2 L1,14" Width="12" Height="12" />
                    </Button>
                  </Grid>

                  <ComboBox Grid.Column="5" Classes="field" ItemsSource="{Binding Llms}" SelectedItem="{Binding Llm}"
                            Margin="0,0,12,0" Opacity="{Binding RowOpacity}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding, Converter={x:Static local:Converters.LlmName}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="6" Classes="field" IsEditable="True" ItemsSource="{Binding Models}"
                            Text="{Binding Model}" IsEnabled="{Binding IsAi}" Opacity="{Binding RowOpacity}"
                            ToolTip.Tip="{local:T model.tip}" />

                  <Panel Grid.Column="7" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                    <ToggleSwitch IsChecked="{Binding Orkester}" IsVisible="{Binding CanOrkester}"
                                  OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0"
                                  ToolTip.Tip="{local:T orkester.tip}" />
                    <Button Classes="link" IsVisible="{Binding CanInstallOrkester}" Click="OnInstallOrkester"
                            AutomationProperties.Name="{local:T install.name}"
                            ToolTip.Tip="{local:T install.tip}">
                      <TextBlock Text="{local:T install.link}" />
                    </Button>
                  </Panel>

                  <ToggleSwitch Grid.Column="8" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="{Binding RowOpacity}"
                                IsChecked="{Binding OnceChecked}" IsEnabled="{Binding CanNonInteractive}" IsVisible="{Binding CanOrkester}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0"
                                ToolTip.Tip="{local:T once.tip}" AutomationProperties.Name="{local:T col.once}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Margin="0,40">
          <TextBlock Classes="muted" Text="{local:T empty.text}"
                     HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{local:T import.button}" Click="OnFindProjects" Classes="accent" ToolTip.Tip="{local:T import.button.tip}" />
            <Button Content="{local:T empty.add}" Click="OnSettings" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0">
      <!-- The running version sits under the status, bottom left, so a report always says which build it was. -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0" Spacing="4">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes.muted="{Binding !StatusIsError}"
                   Foreground="{Binding StatusIsError, Converter={x:Static local:Converters.ErrorBrush}}" />
        <TextBlock Classes="muted" Text="{Binding VersionText}" FontSize="11.5" ToolTip.Tip="{local:T version.tip}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="main-action" Height="{Binding #LaunchButton.Bounds.Height}" Content="{Binding RestartAllLabel}" Click="OnRestartAll"
              IsVisible="{Binding CanRestartAll}" ToolTip.Tip="{local:T restartAll.tip}" AutomationProperties.Name="{local:T restartAll.name}" Margin="0,0,12,0" Padding="16,8" />
      <Button Grid.Column="2" Classes="main-action" Height="{Binding #LaunchButton.Bounds.Height}" Content="{local:T close.title}" Click="OnCloseAll" IsEnabled="{Binding CanCloseAll}" Margin="0,0,12,0" Padding="16,8" />
      <Button x:Name="LaunchButton" Grid.Column="3" Classes="boost" Click="OnLaunch" AutomationProperties.Name="{Binding LaunchLabel}" IsDefault="True" IsEnabled="{Binding CanLaunch}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Data="{StaticResource BoltIcon}" Fill="White" Width="12" Height="15" Stretch="Uniform"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding LaunchLabel}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>

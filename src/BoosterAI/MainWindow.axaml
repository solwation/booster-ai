<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding AppTitle}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="1100" Height="560" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <!--
    Today's choices: which tabs, the AI, model and /orkester for each, plus expandable subtabs.
    Project names/directories are edited in Settings; subtab names are edited here. The header and the rows share
    one responsive column layout (with enough room for longer agent names such as interpreter)
    inside the same padding, so labels sit exactly over their fields.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="28,22,28,20">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <Image Grid.Column="0" Source="avares://BoosterAI/Assets/boosterai.png" Width="40" Height="40"
             VerticalAlignment="Center" Margin="0,0,14,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="title" Text="BoosterAI" />
        <TextBlock Classes="muted" Text="{local:T main.subtitle}" />
      </StackPanel>
      <Button Grid.Column="2" Classes="main-action secondary" Click="OnSettings" Padding="12,8" AutomationProperties.Name="{local:T settings.button}" VerticalAlignment="Center"
              ToolTip.Tip="{local:T settings.tip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource GearIcon}" Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{local:T settings.button}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Banners. At most one action among them is primary (MainViewModel.PrimaryBanner); the rest are secondary. -->
    <StackPanel Grid.Row="1">
    <!-- Error (#153): the cause in one sentence, one or two recovery actions and a close button (ErrorBannerViewModel). -->
    <Border Classes="update danger" IsVisible="{Binding Error.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Path Grid.Column="0" Data="{StaticResource WarningIcon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <SelectableTextBlock Classes="body-small" Grid.Column="1" Text="{Binding Error.Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding Error.FirstIsPrimary}" Content="{Binding Error.FirstLabel}" Click="OnErrorFirst"
                  IsVisible="{Binding Error.HasFirst}" Padding="14,6" />
          <Button Content="{Binding Error.SecondLabel}" Click="OnErrorSecond" IsVisible="{Binding Error.HasSecond}" Padding="14,6" />
        </StackPanel>
        <Button Grid.Column="3" Classes="icon" Click="OnErrorClose" Margin="10,0,-4,0" VerticalAlignment="Center"
                ToolTip.Tip="{local:T error.close}" AutomationProperties.Name="{local:T error.close}">
          <Path Data="{StaticResource CloseIcon}" />
        </Button>
      </Grid>
    </Border>

    <!-- Update prompt: a quiet bar, only while a newer release is offered (see UpdateViewModel). -->
    <Border Classes="update" IsVisible="{Binding Update.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="body-small" Text="{Binding Update.Text}" TextWrapping="Wrap" Classes.failed="{Binding Update.Failed}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Update.HasSummary}">
            <TextBlock Classes="caption" Text="{Binding Update.Summary}" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" ToolTip.Tip="{Binding Update.Summary}" />
            <Button Grid.Column="1" Classes="link" Click="OnUpdateMore" Margin="10,0,0,0" Padding="0"
                    ToolTip.Tip="{Binding Update.MoreUrl}" AutomationProperties.Name="{local:T update.more.name}">
              <TextBlock Classes="caption" Text="{local:T update.more}" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding UpdatePrimary}" Content="{local:T update.install}" Click="OnUpdateInstall" IsVisible="{Binding Update.ShowInstall}"
                  ToolTip.Tip="{Binding Update.InstallTip}" Padding="14,6" />
          <Button Classes.primary="{Binding UpdatePrimary}" Content="{local:T update.page}" Click="OnUpdatePage" IsVisible="{Binding Update.ShowPage}"
                  ToolTip.Tip="{Binding Update.PageUrl}" Padding="14,6" />
          <Button Content="{local:T update.later}" Click="OnUpdateLater" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
          <Button Content="{local:T update.skip}" Click="OnUpdateSkip" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Denied commands: agy refused a command in a Run once tab; offer allow-rules (see DenialViewModel). -->
    <Border Classes="update" IsVisible="{Binding Denial.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource ShieldIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Denial.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding DenialPrimary}" Content="{local:T denied.allow}" Click="OnAllowDenied" ToolTip.Tip="{Binding Denial.AllowTip}" Padding="14,6" />
          <Button Content="{local:T denied.dismiss}" Click="OnDismissDenied" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Setup (#74): WSL or AI CLIs missing where the tabs run, and the full-auto alias offer (see SetupViewModel). -->
    <Border Classes="update" IsVisible="{Binding Setup.WslVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Setup.WslText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes.primary="{Binding WslPrimary}" Content="{local:T setup.wsl.install}" Click="OnInstallWsl" IsVisible="{Binding Setup.CanInstallWsl}"
                ToolTip.Tip="{local:T setup.wsl.install.tip}" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Classes="update" IsVisible="{Binding Setup.MissingVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Setup.MissingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Setup.Missing}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:CliOffer">
                <Button Classes.primary="{Binding $parent[ItemsControl].((local:MainViewModel)DataContext).MissingPrimary}" Content="{Binding Label}" Click="OnInstallCli" ToolTip.Tip="{Binding Tip}" Padding="14,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{local:T setup.dismiss}" Click="OnDismissMissing" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Optimization (#76): WSL memory not tuned, offer quick optimize. -->
    <Border Classes="update" IsVisible="{Binding Optimization.BannerVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource BoltIcon}" Width="14" Height="14" Stretch="Uniform"
              Fill="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{local:T optimization.banner.text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding OptimizationPrimary}" Content="{local:T optimization.banner.button}" Click="OnOptimizeWsl" Padding="14,6" />
          <Button Content="{local:T optimization.banner.dismiss}" Click="OnDismissOptimization" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <!-- Column widths are set in MainWindow.axaml.cs (ProjectColumns): compact or wide, orchestra shown or 0 (#152). -->
    <Grid Grid.Row="2" Classes="project-columns" Loaded="OnProjectGridLoaded" ColumnDefinitions="4,20,46,4*,5*,166,195,168" Margin="0,0,0,6" IsVisible="{Binding HasTabs}">
      <TextBlock Grid.Column="2" Classes="colhead" Text="{local:T col.with}" />
      <TextBlock Grid.Column="3" Classes="colhead" Text="{local:T col.project}" />
      <TextBlock Grid.Column="4" Classes="colhead" Text="{local:T col.status}" />
      <TextBlock Grid.Column="5" Classes="colhead" Text="{local:T col.llm}" />
      <TextBlock Grid.Column="6" Classes="colhead" Text="{local:T col.model}" />
      <TextBlock Grid.Column="7" Classes="colhead" Text="{local:T col.orkester}" IsVisible="{Binding ShowOrchestraColumn}" />
    </Grid>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <ItemsControl ItemsSource="{Binding VisibleTabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TabViewModel">
              <!-- Keyboard (#156): Alt+Up/Down moves the focused row (KeyDown), and the row menu offers the row's actions. -->
              <Border Classes="row" DragDrop.AllowDrop="True" DragDrop.DragOver="OnTabDragOver"
                      DragDrop.DragLeave="OnTabDragLeave" DragDrop.Drop="OnTabDrop" KeyDown="OnRowKeyDown">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{local:T row.menu.up}" Click="OnRowMoveUp" IsEnabled="{Binding CanMoveUp}" />
                    <MenuItem Header="{local:T row.menu.down}" Click="OnRowMoveDown" IsEnabled="{Binding CanMoveDown}" />
                    <Separator />
                    <MenuItem Header="{local:T row.menu.restart}" Click="OnRestart" IsEnabled="{Binding CanRestart}" />
                    <MenuItem Header="{local:T row.menu.continue}" Click="OnContinue" IsEnabled="{Binding CanContinueClosed}" />
                    <Separator />
                    <MenuItem Header="{x:Static local:TabViewModel.OpenFolderName}" Click="OnOpenFolder" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                <Grid Classes="project-columns" Loaded="OnProjectGridLoaded" ColumnDefinitions="4,20,46,4*,5*,166,195,168">
                  <!-- A project's colour stripe; a subtab instead continues it as a 1 px guide (#156). -->
                  <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="{StaticResource RadiusSmall}" IsVisible="{Binding IsProject}" />
                  <Border Grid.Column="0" Classes="subtab-guide" IsVisible="{Binding IsSubTab}" Margin="1,-12,0,-10" />
                  <Border Grid.Column="1" Classes="grip" PointerPressed="OnTabDragStart"
                          ToolTip.Tip="{local:T tab.reorder.tip}" AutomationProperties.Name="{Binding ReorderName}">
                    <Path Data="{StaticResource GripIcon}" />
                  </Border>

                  <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Classes.alive="{Binding IsAlive}" AutomationProperties.Name="{Binding OpenTip}"
                            VerticalAlignment="Center" MinWidth="0" ToolTip.Tip="{Binding OpenTip}" />

                  <!-- The folder belongs to the project; children only edit their own tab name, indented 20 px. Only the
                       name dims on an unticked row; the icon buttons keep full opacity (#156). -->
                  <Grid Grid.Column="3" ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Grid.Column="0" Classes="icon" Click="OnExpandProject" IsVisible="{Binding IsProject}"
                            Padding="2,4" Margin="-4,0,4,0" Width="20"
                            ToolTip.Tip="{local:T subtab.expand}" AutomationProperties.Name="{local:T subtab.expand}">
                      <Panel>
                        <Path Data="{StaticResource ChevronRightIcon}" IsVisible="{Binding !Expanded}" />
                        <Path Data="{StaticResource ChevronDownIcon}" IsVisible="{Binding Expanded}" />
                      </Panel>
                    </Button>
                    <Border Grid.Column="0" Width="40" IsVisible="{Binding IsSubTab}" />
                    <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}" IsVisible="{Binding IsProject}" Opacity="{Binding RowOpacity}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Directory}" />
                    <TextBox Grid.Column="1" Classes="inline name" Text="{Binding Name}" IsVisible="{Binding IsSubTab}" Opacity="{Binding RowOpacity}"
                             Watermark="{local:T col.tabname}" ToolTip.Tip="{Binding Directory}" MinWidth="30" />
                    <Button Grid.Column="2" Classes="icon" Click="OnOpenFolder" Margin="4,-6,0,-6" IsVisible="{Binding IsProject}"
                            ToolTip.Tip="{x:Static local:TabViewModel.OpenFolderName}" AutomationProperties.Name="{x:Static local:TabViewModel.OpenFolderName}">
                      <Path Data="{StaticResource FolderIcon}" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Click="OnRemoveSubTab" IsVisible="{Binding IsSubTab}"
                            IsEnabled="{Binding CanRemoveSubTab}" Margin="2,0,0,0"
                            ToolTip.Tip="{local:T subtab.remove.tip}" AutomationProperties.Name="{local:T subtab.remove}">
                      <Path Data="{StaticResource CloseIcon}" />
                    </Button>
                  </Grid>

                  <Grid Grid.Column="4" ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                        Margin="0,0,12,0" IsVisible="{Binding HasStatus}" ClipToBounds="True">
                    <!-- Hover previews; keyboard or click opens the same details until dismissed. It fills its column (#156):
                         left-aligned, it could keep a stale narrow arrange after ↻/Continue hid and truncate the status. -->
                    <local:StatusPeekButton Grid.Column="0" Classes="status-peek" HorizontalAlignment="Stretch"
                          Click="OnStatusPeek" KeyDown="OnStatusPeekKeyDown"
                          AutomationProperties.Name="{Binding StatusActionName}"
                          ToolTip.ToolTipOpening="OnStatusTipOpening" PropertyChanged="OnStatusTipIsOpenChanged">
                      <ToolTip.Tip>
                        <ToolTip Classes="output"><local:StatusPeekView /></ToolTip>
                      </ToolTip.Tip>
                      <Grid ColumnDefinitions="Auto,*">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Classes="caption" Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </local:StatusPeekButton>
                    <!-- Restart is ↻; Continue is a word, shown only when the conversation can be continued (#156). -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Classes="icon" Click="OnRestart" IsVisible="{Binding ShowReload}" Margin="7,-6,0,-6"
                              ToolTip.Tip="{Binding RestartTip}" AutomationProperties.Name="{Binding ReloadName}">
                        <Path Data="{StaticResource RestartIcon}" />
                      </Button>
                      <Button Classes="link" Click="OnContinue" IsVisible="{Binding CanContinueClosed}" Margin="6,0,0,0"
                              Padding="0,4" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding ContinueTip}" AutomationProperties.Name="{Binding ContinueName}">
                        <TextBlock Classes="caption" Text="{local:T restart.continue.link}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <ComboBox Grid.Column="5" Classes="field" ItemsSource="{Binding Llms}" SelectedItem="{Binding Llm}"
                            Margin="0,0,12,0" Opacity="{Binding RowOpacity}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <!-- A CLI missing where the tabs run gets a warning marker after its name, not a text suffix (#152). -->
                        <StackPanel Orientation="Horizontal" Spacing="6"><local:AgentIcon Cli="{Binding}" Width="16" Height="16" /><TextBlock Text="{Binding, Converter={x:Static local:Converters.LlmName}}" VerticalAlignment="Center" />
                          <Border Background="Transparent" VerticalAlignment="Center" IsVisible="{Binding, Converter={x:Static local:Converters.LlmMissing}}"
                                  ToolTip.Tip="{Binding, Converter={x:Static local:Converters.LlmMissingName}}"
                                  AutomationProperties.Name="{Binding, Converter={x:Static local:Converters.LlmMissingName}}">
                            <Path Classes="missing" Data="{StaticResource WarningIcon}" />
                          </Border></StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="6" Classes="field" IsEditable="True" ItemsSource="{Binding Models}"
                            Text="{Binding Model}" IsEnabled="{Binding IsAi}" Opacity="{Binding RowOpacity}"
                            Margin="0,0,12,0" ToolTip.Tip="{local:T model.tip}" />

                  <!-- One choice for the orchestra and Run once (#152); empty where the folder has no orchestra to use or install. -->
                  <Panel Grid.Column="7" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                    <ComboBox Classes="field words" ItemsSource="{x:Static local:TabViewModel.OrchestraModes}"
                              SelectedIndex="{Binding OrchestraMode}" IsVisible="{Binding CanOrkester}"
                              ToolTip.Tip="{local:T orkester.mode.tip}" AutomationProperties.Name="{local:T col.orkester}" />
                    <Button Classes="link" IsVisible="{Binding CanInstallOrkester}" Click="OnInstallOrkester"
                            AutomationProperties.Name="{local:T install.name}"
                            ToolTip.Tip="{local:T install.tip}">
                      <TextBlock Text="{local:T install.link}" />
                    </Button>
                  </Panel>
                </Grid>
                <!-- Only an expanded project carries a line under it, so collapsed rows keep one rhythm (#152). -->
                <Panel IsVisible="{Binding IsProject}">
                  <Panel IsVisible="{Binding Expanded}">
                    <Border Classes="subtab-guide" Margin="1,0,0,-10" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="62,6,0,2">
                      <Button Classes="link" Content="{local:T subtab.add}" Click="OnAddSubTab" Padding="0,2"
                              AutomationProperties.Name="{local:T subtab.add}" />
                      <TextBlock Classes="muted caption" Text="{Binding SubTabSummary}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Panel>
                </Panel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Margin="0,40">
          <TextBlock Classes="muted" Text="{local:T empty.text}"
                     HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{local:T import.button}" Click="OnFindProjects" Classes="primary" ToolTip.Tip="{local:T import.button.tip}" />
            <Button Content="{local:T empty.add}" Click="OnAddProject" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0">
      <!-- The running version sits under the status, bottom left, so a report always says which build it was.
           The status line is for neutral acknowledgements only; errors use the banner at the top (#153). -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0" Spacing="4">
        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted caption" Text="{Binding VersionText}" ToolTip.Tip="{local:T version.tip}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="main-action secondary" Height="{Binding #LaunchButton.Bounds.Height}" Content="{Binding RestartAllLabel}" Click="OnRestartAll"
              IsVisible="{Binding CanRestartAll}" ToolTip.Tip="{local:T restartAll.tip}" AutomationProperties.Name="{local:T restartAll.name}" Margin="0,0,12,0" Padding="16,8" />
      <!-- Hidden only in the empty state; otherwise inactive with a reason while no tab is open (#148). -->
      <Button Grid.Column="2" Classes="main-action secondary" Height="{Binding #LaunchButton.Bounds.Height}" Content="{local:T close.title}" Click="OnCloseAll"
              IsVisible="{Binding HasTabs}" IsEnabled="{Binding CanCloseAll}" ToolTip.Tip="{Binding CloseAllTip}" ToolTip.ShowOnDisabled="True" Margin="0,0,12,0" Padding="16,8" />
      <Button x:Name="LaunchButton" Grid.Column="3" Classes="boost" Click="OnLaunch" AutomationProperties.Name="{Binding LaunchLabel}" ToolTip.Tip="{Binding LaunchTip}" IsDefault="True" IsEnabled="{Binding CanLaunch}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Data="{StaticResource BoltIcon}" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="15" Stretch="Uniform"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding LaunchLabel}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding AppTitle}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="1100" Height="560" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <!--
    Today's choices: which tabs, the AI, model and /orkester for each; a project and its subtabs form one group card.
    Project names/directories are edited in Settings; subtab names are edited here. The header and the rows share
    one responsive column layout (with enough room for longer agent names such as interpreter)
    inside the same padding, so labels sit exactly over their fields.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="28,22,28,20">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,20">
      <Image Grid.Column="0" Source="avares://BoosterAI/Assets/boosterai.png" Width="40" Height="40"
             VerticalAlignment="Center" Margin="0,0,14,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="title" Text="BoosterAI" />
        <TextBlock Classes="muted" Text="{local:T main.subtitle}" />
      </StackPanel>
      <!-- The Advisor switch (#180): the Advisor row under Claude projects only on demand; shown while a project runs claude. -->
      <ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowAdvisor}" IsVisible="{Binding CanShowAdvisor}"
                    OnContent="{local:T advisor.label}" OffContent="{local:T advisor.label}" VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTip.Tip="{local:T advisor.switch.tip}" AutomationProperties.Name="{local:T advisor.switch.name}" />
      <Button Grid.Column="3" Classes="main-action secondary" Click="OnSettings" Padding="12,8" AutomationProperties.Name="{local:T settings.button}" VerticalAlignment="Center"
              ToolTip.Tip="{local:T settings.tip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource GearIcon}" Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{local:T settings.button}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Banners. At most one action among them is primary (MainViewModel.PrimaryBanner); the rest are secondary. -->
    <StackPanel Grid.Row="1">
    <!-- Error (#153): the cause in one sentence, one or two recovery actions and a close button (ErrorBannerViewModel). -->
    <Border Classes="update danger" IsVisible="{Binding Error.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Path Grid.Column="0" Data="{StaticResource WarningIcon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <SelectableTextBlock Classes="body-small" Grid.Column="1" Text="{Binding Error.Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding Error.FirstIsPrimary}" Content="{Binding Error.FirstLabel}" Click="OnErrorFirst"
                  IsVisible="{Binding Error.HasFirst}" Padding="14,6" />
          <Button Content="{Binding Error.SecondLabel}" Click="OnErrorSecond" IsVisible="{Binding Error.HasSecond}" Padding="14,6" />
        </StackPanel>
        <Button Grid.Column="3" Classes="icon" Click="OnErrorClose" Margin="10,0,-4,0" VerticalAlignment="Center"
                ToolTip.Tip="{local:T error.close}" AutomationProperties.Name="{local:T error.close}">
          <Path Data="{StaticResource CloseIcon}" />
        </Button>
      </Grid>
    </Border>

    <!-- Low-quota warnings (#211): quiet, non-modal, one bar per agent/account/window, closed by the user. -->
    <ItemsControl ItemsSource="{Binding Quota.Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:QuotaNotice">
          <Border CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                  Background="{DynamicResource SurfaceBrush}" Padding="14,8" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Data="{StaticResource WarningIcon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
                    StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Grid.Column="1" Classes="body-small" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
              <Button Grid.Column="2" Classes="icon" Click="OnQuotaClose" Margin="10,0,-4,0" VerticalAlignment="Center"
                      ToolTip.Tip="{local:T quota.warn.close}" AutomationProperties.Name="{local:T quota.warn.close}">
                <Path Data="{StaticResource CloseIcon}" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Update prompt: a quiet bar, only while a newer release is offered (see UpdateViewModel). -->
    <Border Classes="update" IsVisible="{Binding Update.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="body-small" Text="{Binding Update.Text}" TextWrapping="Wrap" Classes.failed="{Binding Update.Failed}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Update.HasSummary}">
            <TextBlock Classes="caption" Text="{Binding Update.Summary}" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" ToolTip.Tip="{Binding Update.Summary}" />
            <Button Grid.Column="1" Classes="link" Click="OnUpdateMore" Margin="10,0,0,0" Padding="0"
                    ToolTip.Tip="{Binding Update.MoreUrl}" AutomationProperties.Name="{local:T update.more.name}">
              <TextBlock Classes="caption" Text="{local:T update.more}" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding UpdatePrimary}" Content="{local:T update.install}" Click="OnUpdateInstall" IsVisible="{Binding Update.ShowInstall}"
                  ToolTip.Tip="{Binding Update.InstallTip}" Padding="14,6" />
          <Button Classes.primary="{Binding UpdatePrimary}" Content="{local:T update.page}" Click="OnUpdatePage" IsVisible="{Binding Update.ShowPage}"
                  ToolTip.Tip="{Binding Update.PageUrl}" Padding="14,6" />
          <Button Content="{local:T update.later}" Click="OnUpdateLater" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
          <Button Content="{local:T update.skip}" Click="OnUpdateSkip" IsVisible="{Binding Update.ShowDismiss}" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Denied commands: agy refused a command in a Run once tab; offer allow-rules (see DenialViewModel). -->
    <Border Classes="update" IsVisible="{Binding Denial.IsVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource ShieldIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Denial.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding DenialPrimary}" Content="{local:T denied.allow}" Click="OnAllowDenied" ToolTip.Tip="{Binding Denial.AllowTip}" Padding="14,6" />
          <Button Content="{local:T denied.dismiss}" Click="OnDismissDenied" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Setup (#74): WSL or AI CLIs missing where the tabs run, and the full-auto alias offer (see SetupViewModel). -->
    <Border Classes="update" IsVisible="{Binding Setup.WslVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Setup.WslText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes.primary="{Binding WslPrimary}" Content="{local:T setup.wsl.install}" Click="OnInstallWsl" IsVisible="{Binding Setup.CanInstallWsl}"
                ToolTip.Tip="{local:T setup.wsl.install.tip}" Padding="14,6" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Classes="update" IsVisible="{Binding Setup.MissingVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
              StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{Binding Setup.MissingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Setup.Missing}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:CliOffer">
                <Button Classes.primary="{Binding $parent[ItemsControl].((local:MainViewModel)DataContext).MissingPrimary}" Content="{Binding Label}" Click="OnInstallCli" ToolTip.Tip="{Binding Tip}" Padding="14,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{local:T setup.dismiss}" Click="OnDismissMissing" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Optimization (#76): WSL memory not tuned, offer quick optimize. -->
    <Border Classes="update" IsVisible="{Binding Optimization.BannerVisible}" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Data="{StaticResource BoltIcon}" Width="14" Height="14" Stretch="Uniform"
              Fill="{DynamicResource LinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Classes="body-small" Grid.Column="1" Text="{local:T optimization.banner.text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Classes.primary="{Binding OptimizationPrimary}" Content="{local:T optimization.banner.button}" Click="OnOptimizeWsl" Padding="14,6" />
          <Button Content="{local:T optimization.banner.dismiss}" Click="OnDismissOptimization" Padding="14,6" />
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <!-- Column widths are set in MainWindow.axaml.cs (ProjectColumns): compact or wide, orchestra shown or 0 (#152), and
         the rows' ⋯ (#196). The header is inset like the rows inside their segment (#196), so labels sit over their fields. -->
    <Grid Grid.Row="2" Classes="project-columns" Loaded="OnProjectGridLoaded" ColumnDefinitions="4,20,46,*,160,200,195,168,32" Margin="5,0,5,6" IsVisible="{Binding HasTabs}">
      <TextBlock Grid.Column="2" Classes="colhead" Text="{local:T col.with}" />
      <TextBlock Grid.Column="3" Classes="colhead" Text="{local:T col.project}" />
      <TextBlock Grid.Column="4" Classes="colhead" Text="{local:T col.status}" />
      <TextBlock Grid.Column="5" Classes="colhead" Text="{local:T col.llm}" />
      <TextBlock Grid.Column="6" Classes="colhead" Text="{local:T col.model}" />
      <TextBlock Grid.Column="7" Classes="colhead" Text="{local:T col.orkester}" IsVisible="{Binding ShowOrchestraColumn}" />
    </Grid>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <ItemsControl ItemsSource="{Binding VisibleTabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TabViewModel">
              <!-- The group card (#196): a project with subtabs and its subtabs share one tinted, outlined card with one
                   continuous colour stripe, drawn as one segment per row (top, middle, bottom) so the list stays flat. A
                   project without subtabs is no group and keeps only its short stripe. -->
              <Border Classes="segment" Classes.grouped="{Binding InGroup}" Classes.top="{Binding GroupTop}" Classes.bottom="{Binding GroupBottom}">
              <Panel>
              <Border Classes="segment-tint" Background="{Binding GroupColorBrush}" IsVisible="{Binding InGroup}" />
              <Border Classes="segment-outline" BorderBrush="{Binding GroupColorBrush}" IsVisible="{Binding InGroup}" />
              <!-- Keyboard (#156): Alt+Up/Down moves the focused row (KeyDown), and the row menu offers the row's actions,
                   also from the row's ⋯ button (#196). -->
              <Border Classes="row" DragDrop.AllowDrop="True" DragDrop.DragOver="OnTabDragOver"
                      DragDrop.DragLeave="OnTabDragLeave" DragDrop.Drop="OnTabDrop" KeyDown="OnRowKeyDown">
                <Border.ContextMenu>
                  <ContextMenu Closed="OnRowMenuClosed">
                    <MenuItem Header="{local:T subtab.create}" Click="OnAddSubTab" />
                    <Separator />
                    <MenuItem Header="{local:T row.menu.up}" Click="OnRowMoveUp" IsEnabled="{Binding CanMoveUp}" />
                    <MenuItem Header="{local:T row.menu.down}" Click="OnRowMoveDown" IsEnabled="{Binding CanMoveDown}" />
                    <Separator />
                    <MenuItem Header="{local:T row.menu.start}" Click="OnStartTab" IsEnabled="{Binding CanStart}" />
                    <MenuItem Header="{local:T row.menu.restart}" Click="OnRestart" IsEnabled="{Binding CanRestart}" />
                    <MenuItem Header="{local:T row.menu.continue}" Click="OnContinue" IsEnabled="{Binding CanContinueClosed}" />
                    <Separator />
                    <MenuItem Header="{x:Static local:TabViewModel.OpenFolderName}" Click="OnOpenFolder" />
                    <MenuItem Header="{Binding RemoveSubTabMenu}" Click="OnRemoveSubTab" IsEnabled="{Binding CanRemoveSubTab}" IsVisible="{Binding IsSubTab}"
                              ToolTip.Tip="{Binding RemoveSubTabTip}" ToolTip.ShowOnDisabled="True" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                <Grid Classes="project-columns" Loaded="OnProjectGridLoaded" ColumnDefinitions="4,20,46,*,160,200,195,168,32">
                  <!-- A project's colour stripe; in a group the segment draws it instead, joined across the rows (#196). -->
                  <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="{StaticResource RadiusSmall}" IsVisible="{Binding !InGroup}" />
                  <Border Grid.Column="1" Classes="grip" PointerPressed="OnTabDragStart"
                          ToolTip.Tip="{local:T tab.reorder.tip}" AutomationProperties.Name="{Binding ReorderName}">
                    <Path Data="{StaticResource GripIcon}" />
                  </Border>

                  <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Classes.alive="{Binding IsAlive}" AutomationProperties.Name="{Binding OpenTip}"
                            VerticalAlignment="Center" MinWidth="0" ToolTip.Tip="{Binding OpenTip}" />

                  <!-- No indent (#196): every name starts at the same x. The project has its name as text and the folder; a
                       subtab has an editable name and × in the folder's place. Only the name dims on an unticked row; the
                       icon buttons keep full opacity (#156). -->
                  <Grid Grid.Column="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Grid.Column="0" Classes="name" Text="{Binding Name}" IsVisible="{Binding IsProject}" Opacity="{Binding RowOpacity}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Directory}" />
                    <TextBox Grid.Column="0" Classes="inline name" Text="{Binding Name}" IsVisible="{Binding IsSubTab}" Opacity="{Binding RowOpacity}"
                             Watermark="{local:T col.tabname}" ToolTip.Tip="{Binding Directory}" MinWidth="30"
                             AutomationProperties.HelpText="{Binding SubTabOfName}" />
                    <Button Grid.Column="1" Classes="icon" Click="OnOpenFolder" Margin="4,-6,0,-6" IsVisible="{Binding IsProject}"
                            ToolTip.Tip="{x:Static local:TabViewModel.OpenFolderName}" AutomationProperties.Name="{x:Static local:TabViewModel.OpenFolderName}">
                      <Path Data="{StaticResource FolderIcon}" />
                    </Button>
                    <!-- Inactive with its reason while the subtab's terminal tab is open (#196). -->
                    <Button Grid.Column="1" Classes="icon" Click="OnRemoveSubTab" IsVisible="{Binding IsSubTab}"
                            IsEnabled="{Binding CanRemoveSubTab}" Margin="4,-6,0,-6"
                            ToolTip.Tip="{Binding RemoveSubTabTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding RemoveSubTabName}">
                      <Path Data="{StaticResource CloseIcon}" />
                    </Button>
                  </Grid>

                  <!-- The compact status column (#209): the status dot with the remaining share ("38 %"), "!" on an error row or "…"
                       while closing or waiting to restart; the full status, its explanation and the plan limits are in the popup. -->
                  <Grid Grid.Column="4" Classes="status-cell" ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                        Margin="0,0,12,0" IsVisible="{Binding ShowStatusColumn}" ClipToBounds="True">
                    <!-- Hover previews; keyboard or click opens the same details until dismissed. It fills its column (#156), so the
                         whole free part of the cell opens the popup and the row actions line up at the column's right edge. -->
                    <local:StatusPeekButton Grid.Column="0" Classes="status-peek" HorizontalAlignment="Stretch" IsVisible="{Binding HasStatus}"
                          Click="OnStatusPeek" KeyDown="OnStatusPeekKeyDown"
                          AutomationProperties.Name="{Binding StatusActionName}"
                          ToolTip.ToolTipOpening="OnStatusTipOpening">
                      <ToolTip.Tip>
                        <ToolTip Classes="output"><local:StatusPeekView /></ToolTip>
                      </ToolTip.Tip>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <local:StatusDotView />
                        <TextBlock Classes="caption status-indicator" Classes.warn="{Binding StatusIndicatorWarn}" Classes.danger="{Binding IsStatusError}"
                                   Text="{Binding StatusIndicatorText}" IsVisible="{Binding HasStatusIndicatorText}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </local:StatusPeekButton>
                    <!-- Restart is ↻; Continue is a word, shown only when the conversation can be continued (#156). A tab never
                         opened has the Start icon in their place (#198): it starts only that tab, in the open terminal window if any. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Classes="icon" Click="OnStartTab" IsVisible="{Binding CanStart}" Margin="0,-6,0,-6"
                              ToolTip.Tip="{local:T tab.start.tip}" AutomationProperties.Name="{Binding StartName}">
                        <Path Data="{StaticResource StartIcon}" />
                      </Button>
                      <!-- Show the tab in the terminal (#213): a separate icon, so the status keeps opening its popup. -->
                      <Button Classes="icon" Click="OnShowTerminal" IsVisible="{Binding CanShowTerminal}" Margin="2,-6,0,-6" Width="26" Padding="3" Cursor="Hand"
                              ToolTip.Tip="{Binding ShowTerminalTip}" AutomationProperties.Name="{Binding ShowTerminalName}">
                        <Path Data="{StaticResource ShowTerminalIcon}" />
                      </Button>
                      <Button Classes="icon" Click="OnRestart" IsVisible="{Binding ShowReload}" Margin="4,-6,0,-6"
                              ToolTip.Tip="{Binding RestartTip}" AutomationProperties.Name="{Binding ReloadName}">
                        <Path Data="{StaticResource RestartIcon}" />
                      </Button>
                      <Button Classes="link" Click="OnContinue" IsVisible="{Binding CanContinueClosed}" Margin="4,0,0,0"
                              Padding="0,4" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding ContinueTip}" AutomationProperties.Name="{Binding ContinueName}">
                        <TextBlock Classes="caption" Text="{local:T restart.continue.link}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- Agent and account in one choice (#194): an agent with accounts besides its default one lists one entry per
                       account, each with the account as a small label after the agent; the others show only the agent. -->
                  <!-- #221: hovering anywhere over the closed box (meters included) previews the same status popup as the status column. -->
                  <Panel Grid.Column="5" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="{Binding RowOpacity}"
                         ToolTip.ToolTipOpening="OnStatusTipOpening">
                    <ToolTip.Tip>
                      <ToolTip Classes="output"><local:StatusPeekView /></ToolTip>
                    </ToolTip.Tip>
                    <ComboBox Classes="field agent-choice" Classes.meters="{Binding SelectedAgentChoice.HasMeters, FallbackValue=False}" ItemsSource="{Binding AgentChoices}" SelectedItem="{Binding SelectedAgentChoice}"
                              AutomationProperties.Name="{Binding SelectedAgentChoice.Name}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:AgentChoice">
                          <!-- A CLI missing where the tabs run gets a warning marker after its name, not a text suffix (#152). -->
                          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" AutomationProperties.Name="{Binding Name}">
                            <local:AgentIcon Grid.Column="0" Cli="{Binding Llm}" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="{Binding Llm, Converter={x:Static local:Converters.LlmName}}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Border Grid.Column="2" Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0"
                                    IsVisible="{Binding Llm, Converter={x:Static local:Converters.LlmMissing}}"
                                    ToolTip.Tip="{Binding Llm, Converter={x:Static local:Converters.LlmMissingName}}"
                                    AutomationProperties.Name="{Binding Llm, Converter={x:Static local:Converters.LlmMissingName}}">
                              <Path Classes="missing" Data="{StaticResource WarningIcon}" />
                            </Border>
                            <Border Grid.Column="3" Classes="account-pill" Margin="4,0,0,0" IsVisible="{Binding ShowAccount}" ToolTip.Tip="{Binding Tip}">
                              <TextBlock Classes="caption" Text="{Binding AccountName}" />
                            </Border>
                            <!-- Plan limit (#200): the dropdown entries show the higher of the 5 h and weekly use ("62 %", with a warning icon from
                                 80 %); the closed box only a small warning marker from 80 %, so the row stays calm. Unknown shows nothing. -->
                            <StackPanel Grid.Column="4" Classes="limit-entry" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasLimit}" Background="Transparent"
                                          ToolTip.Tip="{Binding LimitTip}" AutomationProperties.Name="{Binding LimitName}">
                                <Path Classes="missing" Width="11" Height="11" Data="{StaticResource WarningIcon}" IsVisible="{Binding LimitWarn}" />
                                <TextBlock Classes="caption" Text="{Binding LimitCaption}" VerticalAlignment="Center" />
                                <TextBlock Classes="muted caption" Text="{Binding LimitStale, StringFormat='· {0}'}" IsVisible="{Binding HasLimitStale}" VerticalAlignment="Center" Margin="3,0,0,0" />
                              </StackPanel>
                              <!-- #214: a limit-capable entry without a known level says so ("Okänd", "Troligen återställd"); the tooltip says why. -->
                              <TextBlock Classes="muted caption" Text="{Binding LimitNoteCaption}" IsVisible="{Binding HasLimitNote}" VerticalAlignment="Center"
                                         Background="Transparent" ToolTip.Tip="{Binding LimitNoteTip}" AutomationProperties.Name="{Binding LimitNoteName}" />
                            </StackPanel>
                            <Panel Grid.Column="4" Classes="limit-closed" Margin="4,0,0,0" VerticalAlignment="Center">
                              <Border Background="Transparent" IsVisible="{Binding LimitWarn}" ToolTip.Tip="{Binding LimitTip}" AutomationProperties.Name="{Binding LimitName}">
                                <Path Classes="missing" Width="11" Height="11" Data="{StaticResource WarningIcon}" />
                              </Border>
                            </Panel>
                            <!-- #219: the same two meters under the agent name, only in the dropdown entries (the closed box draws its own). -->
                            <Panel Grid.Row="1" Grid.ColumnSpan="3" Classes="limit-entry"><StackPanel Spacing="1" Width="64" HorizontalAlignment="Left" Margin="22,2,0,1"
                                        IsVisible="{Binding HasMeters}" Background="Transparent"
                                        ToolTip.Tip="{Binding MeterTip}" AutomationProperties.Name="{Binding MeterName}">
                              <ProgressBar Classes="limit-meter" Classes.warn="{Binding SessionMeterWarn}" Classes.unknown="{Binding SessionMeterUnknown}"
                                           Value="{Binding SessionMeterPercent}" Minimum="0" Maximum="100" Height="3" MinHeight="3" MinWidth="0" />
                              <ProgressBar Classes="limit-meter" Classes.warn="{Binding WeekMeterWarn}" Classes.unknown="{Binding WeekMeterUnknown}"
                                           Value="{Binding WeekMeterPercent}" Minimum="0" Maximum="100" Height="3" MinHeight="3" MinWidth="0" />
                            </StackPanel></Panel>
                          </Grid>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Usage meters (#202, #219): two thin bars inside the closed box's bottom edge, the 5 h window on top and the week below,
                         each filled to its own use; from 80 % in the warning colour, beside the warning icon. A window without a known level
                         (Unknown or reset) is an empty, muted track. They lie over the box's padding at a fixed place, so neither the box nor
                         the row grows and every row's tracks have the same length. The tooltip lists both windows; a press opens the box. -->
                    <Panel Classes="limit-meter" VerticalAlignment="Bottom" Height="7" Margin="11,0,11,1" Background="Transparent"
                           IsVisible="{Binding SelectedAgentChoice.HasMeters, FallbackValue=False}"
                           AutomationProperties.Name="{Binding SelectedAgentChoice.MeterName}" PointerPressed="OnLimitMeterPressed">
                      <StackPanel Spacing="1" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ProgressBar Classes="limit-meter" Classes.warn="{Binding SelectedAgentChoice.SessionMeterWarn, FallbackValue=False}"
                                     Classes.unknown="{Binding SelectedAgentChoice.SessionMeterUnknown, FallbackValue=False}"
                                     Value="{Binding SelectedAgentChoice.SessionMeterPercent, FallbackValue=0}" Minimum="0" Maximum="100"
                                     Height="3" MinHeight="3" MinWidth="0" />
                        <ProgressBar Classes="limit-meter" Classes.warn="{Binding SelectedAgentChoice.WeekMeterWarn, FallbackValue=False}"
                                     Classes.unknown="{Binding SelectedAgentChoice.WeekMeterUnknown, FallbackValue=False}"
                                     Value="{Binding SelectedAgentChoice.WeekMeterPercent, FallbackValue=0}" Minimum="0" Maximum="100"
                                     Height="3" MinHeight="3" MinWidth="0" />
                      </StackPanel>
                    </Panel>
                  </Panel>
                  <ComboBox Grid.Column="6" Classes="field" IsEditable="True" ItemsSource="{Binding Models}"
                            Text="{Binding Model}" IsEnabled="{Binding IsAi}" Opacity="{Binding RowOpacity}"
                            Margin="0,0,12,0" ToolTip.Tip="{local:T model.tip}" />

                  <!-- One choice for the orchestra and Run once (#152); empty where the folder has no orchestra to use or install. -->
                  <Panel Grid.Column="7" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                    <ComboBox Classes="field words" ItemsSource="{x:Static local:TabViewModel.OrchestraModes}"
                              SelectedIndex="{Binding OrchestraMode}" IsVisible="{Binding CanOrkester}"
                              ToolTip.Tip="{local:T orkester.mode.tip}" AutomationProperties.Name="{local:T col.orkester}" />
                    <Button Classes="link" IsVisible="{Binding CanInstallOrkester}" Click="OnInstallOrkester"
                            AutomationProperties.Name="{local:T install.name}"
                            ToolTip.Tip="{local:T install.tip}">
                      <TextBlock Text="{local:T install.link}" />
                    </Button>
                  </Panel>

                  <!-- More options (#196): the row menu (Create subtab first) for mouse, keyboard and screen readers. -->
                  <Button Grid.Column="8" Classes="icon" Click="OnRowMore" HorizontalAlignment="Right" VerticalAlignment="Center"
                          ToolTip.Tip="{local:T row.more.tip}" AutomationProperties.Name="{Binding MoreName}">
                    <Path Data="{StaticResource MoreIcon}" StrokeThickness="2.5" />
                  </Button>
                </Grid>
                <!-- Advisor belongs to the project choices (#173). -->
                <Panel IsVisible="{Binding IsProject}">
                  <Grid Classes="project-columns" Loaded="OnProjectGridLoaded" ColumnDefinitions="4,20,46,*,160,200,195,168,32"
                        RowDefinitions="Auto,Auto" IsVisible="{Binding AdvisorVisible}" Margin="0,6,0,0">
                    <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Classes="muted caption" Text="{local:T advisor.scope}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="5" Classes="muted caption" Text="{local:T advisor.label}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="6" Classes="field" IsEditable="True" ItemsSource="{Binding Advisors}" Text="{Binding AdvisorChoice}"
                              Margin="0,0,12,0" ToolTip.Tip="{local:T advisor.tip}" AutomationProperties.Name="{local:T advisor.label}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" Classes="caption" Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding AdvisorWarning}" IsVisible="{Binding HasAdvisorWarning}" TextWrapping="Wrap" Margin="0,4,12,0" />
                  </Grid>
                </Panel>
                </StackPanel>
              </Border>
              <!-- The group's stripe, continuous across its segments; drawn over the row so its hover cannot hide it. -->
              <Border Classes="segment-stripe" Background="{Binding GroupColorBrush}" IsVisible="{Binding InGroup}" />
              </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Margin="0,40">
          <TextBlock Classes="muted" Text="{local:T empty.text}"
                     HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{local:T import.button}" Click="OnFindProjects" Classes="primary" ToolTip.Tip="{local:T import.button.tip}" />
            <Button Content="{local:T empty.add}" Click="OnAddProject" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0">
      <!-- The running version sits under the status, bottom left, so a report always says which build it was.
           The status line is for neutral acknowledgements only; errors use the banner at the top (#153). -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0" Spacing="4">
        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- #226: the version opens the same page as the update banner's "Show more" (the changes since this version, or the latest release). -->
        <Button Classes="link version" HorizontalAlignment="Left" Padding="0" Click="OnUpdateMore"
                ToolTip.Tip="{local:T version.tip}" AutomationProperties.Name="{Binding VersionName}">
          <TextBlock Classes="muted caption" Text="{Binding VersionText}" />
        </Button>
      </StackPanel>
      <Button Grid.Column="1" Classes="main-action secondary" Height="{Binding #LaunchButton.Bounds.Height}" Content="{Binding RestartAllLabel}" Click="OnRestartAll"
              IsVisible="{Binding CanRestartAll}" ToolTip.Tip="{local:T restartAll.tip}" AutomationProperties.Name="{local:T restartAll.name}" Margin="0,0,12,0" Padding="16,8" />
      <!-- Hidden only in the empty state; otherwise inactive with a reason while no tab is open (#148). -->
      <Button Grid.Column="2" Classes="main-action secondary" Height="{Binding #LaunchButton.Bounds.Height}" Content="{local:T close.title}" Click="OnCloseAll"
              IsVisible="{Binding HasTabs}" IsEnabled="{Binding CanCloseAll}" ToolTip.Tip="{Binding CloseAllTip}" ToolTip.ShowOnDisabled="True" Margin="0,0,12,0" Padding="16,8" />
      <Button x:Name="LaunchButton" Grid.Column="3" Classes="boost" Click="OnLaunch" AutomationProperties.Name="{Binding LaunchLabel}" ToolTip.Tip="{Binding LaunchTip}" IsDefault="True" IsEnabled="{Binding CanLaunch}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Data="{StaticResource BoltIcon}" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="15" Stretch="Uniform"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding LaunchLabel}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>

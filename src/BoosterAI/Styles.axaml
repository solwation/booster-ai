<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the start and settings windows. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- Type scale (#149): display 28/34, title 20/26, subtitle 16/22, sectionhead 14/20 (all SemiBold), body 14/20,
       body-small 13/18, caption 12/16. Only the Regular, Medium and SemiBold weights; no other local FontSize. -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.body-small">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.colhead">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A form field's label outranks its help text: label in text colour, help muted. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- Status text: error and success colours come from the theme tokens. -->
  <Style Selector="TextBlock.error, SelectableTextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.sectionhead">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Settings side navigation (#157): one look for Minne och kontext and AI-agenter. A 168 px column of 36 px items,
       13 Medium; the chosen item gets the row hover fill, a 3 px accent bar on the left and SemiBold. -->
  <Style Selector="ListBox.sidenav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem, Button.sidenav">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem">
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSmall}">
          <Panel>
            <Border Name="PART_Bar" Width="3" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusSmall}" IsVisible="False"
                    Background="{DynamicResource SystemAccentColor}" />
            <ContentPresenter Name="PART_NavContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Focus" BorderThickness="2" BorderBrush="{DynamicResource LinkBrush}"
                    CornerRadius="{StaticResource RadiusSmall}" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.sidenav">
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSmall}">
          <Panel>
            <Border Name="PART_Bar" Width="3" HorizontalAlignment="Left" CornerRadius="{StaticResource RadiusSmall}" IsVisible="False"
                    Background="{DynamicResource SystemAccentColor}" />
            <ContentPresenter Name="PART_NavContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Focus" BorderThickness="2" BorderBrush="{DynamicResource LinkBrush}"
                    CornerRadius="{StaticResource RadiusSmall}" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem:pointerover, Button.sidenav:pointerover">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem:selected, Button.sidenav.chosen">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem:selected /template/ Border#PART_Bar, Button.sidenav.chosen /template/ Border#PART_Bar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.sidenav ListBoxItem:focus-visible /template/ Border#PART_Focus, Button.sidenav:focus-visible /template/ Border#PART_Focus">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.agent-nav">
    <Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.agent-nav.chosen">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.agent-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Padding" Value="14" /><Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- Logo plate on the agent overview cards (#158): 28x28 SurfaceStrong, radius 6, a 16 px logo. -->
  <Style Selector="Border.logo-plate">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
  </Style>
  <Style Selector="TextBlock.link-text">
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Border.agent-group">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.memory-track">
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
  </Style>
  <Style Selector="Border.memory-stat">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="TextBlock.memory-axis">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- Settings main tabs (#157): unselected Regular in MutedBrush, selected SemiBold in TextBrush over a 2 px accent line.
       Every page starts with its title at the same y: the tab content's top padding is the only gap above it. -->
  <Style Selector="TabControl.settings-tabs">
    <Setter Property="Padding" Value="0,16,0,0" />
  </Style>
  <Style Selector="TabControl.settings-tabs > TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TabControl.settings-tabs > TabItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TabControl.settings-tabs > TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings-tabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   TabControl.settings-tabs > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.settings-tabs > TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Height" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="TextBlock.name">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.path, SelectableTextBlock.path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The status popup with a tab's last lines: wider than a normal tip (see TabOutputView). -->
  <Style Selector="ToolTip.output">
    <Setter Property="MaxWidth" Value="2000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- The popup's own surface (StatusPeekView draws it: opaque, edge, shadow). -->
  <Style Selector="Border.peek-surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="BoxShadow" Value="{StaticResource PopupShadow}" />
    <Setter Property="TextElement.FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector="TextBlock.peek-header">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.status-peek">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="3,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.status-peek:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="FlyoutPresenter.status-output">
    <Setter Property="MaxWidth" Value="2000" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Small secondary text (the 12/16 step of the type scale); pair with muted for captions beside controls. -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <!-- A callout: a recommendation or a result card. The success/warning/danger variants add a 3 px left edge. -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.callout.success"><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.callout.warning"><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.callout.danger"><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>

  <!-- Numbered step circles: the setup wizard and the Local models window (#155). -->
  <Style Selector="Border.step">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource FaintBrush}" />
  </Style>
  <Style Selector="Border.step.current, Border.step.past">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="Border.step TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.step.current TextBlock, Border.step.past TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.stepname">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.stepname.current">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A list row: quiet until hovered. -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="Border.row.drop-before">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.row.drop-after">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Inline-editable text: reads as text, becomes a field on hover/focus. -->
  <Style Selector="TextBox.inline">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="-6,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource TextControlBackgroundFocused}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="TextBox.name">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ComboBox.field">
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- A field whose choices are words, not values (the orchestra mode, #152): mono only on values. -->
  <Style Selector="ComboBox.field.words">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <!-- The agent's CLI is missing where the tabs run (#152): a warning triangle after its name. -->
  <Style Selector="Path.missing">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
  </Style>

  <!-- Small borderless icon buttons (#156): a 16 px icon box drawn with a 1.5 px stroke at native geometry size, full
       opacity in FaintBrush (>= 4.5:1), TextBrush on hover and keyboard focus. Only an inactive button is dimmed. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource FaintBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.icon:pointerover Path, Button.icon:focus-visible Path">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- A disabled icon button (the subtab's × while its tab is open) gets no grey box, only its dimmed glyph (#152). -->
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled Path">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- The drag grip (#156): focusable, so Alt+Up/Down can move its row; keyboard focus shows a ring. -->
  <Style Selector="Border.grip">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.grip:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Border.grip Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource FaintBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.grip:pointerover Path, Border.grip:focus-visible Path">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- A subtab's guide (#156): a 1 px line continuing down from the parent's colour stripe. -->
  <Style Selector="Border.subtab-guide">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="1,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- The update prompt: a soft outlined bar, not a dialog. -->
  <Style Selector="Border.update">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <!-- The error banner (#153): danger border and icon, a soft danger surface, body text in TextBrush. -->
  <Style Selector="Border.update.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
  </Style>

  <Style Selector="Border.update TextBlock.failed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Tab colour stripe; a button in settings, where it cycles the colour. -->
  <Style Selector="Button.stripe">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSmall}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <!-- A caption link (Fortsätt, #156; Show more) keeps the 12 px caption size instead of the link's 13. -->
  <Style Selector="Button.link TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Theme picker: each theme a padded chip, the chosen one outlined in the accent. -->
  <Style Selector="ListBox.themes ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="ListBox.themes ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="ListBox.themes ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <!-- Button system (#148): boost (Starta only), primary (at most one per view: the view's task), secondary (the
       default look, also for plain buttons via the Fluent keys in App.axaml), danger (a dangerous path beside a safe
       one). Every variant is inactive the same way: no fill, a half-opaque border and FaintBrush text. -->
  <Style Selector="Button.boost, Button.main-action">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
  </Style>
  <Style Selector="Button.main-action">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryFillBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryFillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryFillHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryFillPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryFillPressedBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFillPressedBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>

  <!-- The one loud element: the launch button in the icon's gradient. -->
  <Style Selector="Button.boost">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="22,11" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.boost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.boost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.boost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>

  <!-- A ticked row that is already running (#151): Start leaves it alone, so it gets no accent fill. Outline in
       MutedBrush and a TextBrush check keep it clearly ticked without looking disabled or indeterminate;
       only rows Start will open keep the accent fill. -->
  <Style Selector="CheckBox.alive:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="CheckBox.alive:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="CheckBox.alive:checked:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="CheckBox.alive:checked /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="CheckBox.alive:checked:pointerover /template/ Path#CheckGlyph, CheckBox.alive:checked:pressed /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- Pick lists (Local models catalog, setup agent list): token background, a quiet hover and a 1 px accent outline for the selected row (no fill). -->
  <Style Selector="ListBox.picklist">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBox.picklist ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.picklist ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.picklist ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.picklist ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.picklist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.picklist ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.picklist ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.picklist ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.picklist ListBoxItem:selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- The setup agent list fits six agents and its hint above the wizard's footer. -->
  <Style Selector="ListBox.picklist.agents ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0" />
  </Style>
</Styles>

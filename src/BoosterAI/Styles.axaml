<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the start and settings windows. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.colhead">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.name">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- The status popup with a tab's last lines: wider than a normal tip (see TabOutputView). -->
  <Style Selector="ToolTip.output">
    <Setter Property="MaxWidth" Value="2000" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- A list row: quiet until hovered. -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="Border.row.drop-before">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.row.drop-after">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Inline-editable text: reads as text, becomes a field on hover/focus. -->
  <Style Selector="TextBox.inline">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="-6,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource TextControlBackgroundFocused}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="TextBox.name">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ComboBox.field">
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Small borderless icon buttons. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.remove">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Border.row:pointerover Button.remove, Button.remove:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The update prompt: a soft outlined bar, not a dialog. -->
  <Style Selector="Border.update">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style Selector="Border.update TextBlock.failed">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>

  <!-- Tab colour stripe; a button in settings, where it cycles the colour. -->
  <Style Selector="Button.stripe">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Theme picker: each theme a padded chip, the chosen one outlined in the accent. -->
  <Style Selector="ListBox.themes ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource RowHoverBrush}" />
  </Style>
  <Style Selector="ListBox.themes ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="ListBox.themes ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
  </Style>

  <!-- Main-window actions share their shape; only boost gets the launch gradient. -->
  <Style Selector="Button.boost, Button.main-action">
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- The one loud element: the launch button in the icon's gradient. -->
  <Style Selector="Button.boost">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="22,11" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.boost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.boost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BoostBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.boost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
  </Style>
</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BoosterAI"
             x:Class="BoosterAI.StatusPeekView" x:DataType="local:TabViewModel">
  <Border Classes="peek-surface">
  <ScrollViewer x:Name="OutputScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="True">
    <StackPanel Spacing="8" Width="{x:Static local:TabOutputView.PopupWidth}">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
        <TextBlock Classes="peek-header" Text="{Binding PeekHeader}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Classes="muted" Text="{Binding PeekDetail}" IsVisible="{Binding HasPeekDetail}"
                 FontSize="12" TextWrapping="Wrap" />
      <local:TabOutputView IsVisible="{Binding HasOutput}" />
      <TextBlock Classes="muted" Text="{Binding OutputNote}" IsVisible="{Binding HasOutputNote}"
                 FontSize="12" TextWrapping="Wrap" />
      <!-- After an exit with an error, ↻ is the popup's primary action (#153); only where it can be clicked. -->
      <Button x:Name="RestartButton" Classes="primary" HorizontalAlignment="Left" Padding="12,6" IsVisible="False"
              Click="OnRestart" ToolTip.Tip="{Binding RestartTip}" AutomationProperties.Name="{Binding ReloadName}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="{StaticResource RestartIcon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                StrokeLineCap="Round" StrokeJoin="Round" Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
          <TextBlock Text="{local:T peek.restart}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </ScrollViewer>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BoosterAI"
             x:Class="BoosterAI.StatusPeekView" x:DataType="local:TabViewModel">
  <ScrollViewer x:Name="OutputScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="True">
    <StackPanel Spacing="8" Width="{x:Static local:TabOutputView.PopupWidth}">
      <TextBlock Text="{Binding StatusTip}" TextWrapping="Wrap" />
      <local:TabOutputView IsVisible="{Binding HasOutput}" />
      <TextBlock Classes="muted" Text="{Binding OutputNote}" IsVisible="{Binding HasOutputNote}"
                 FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

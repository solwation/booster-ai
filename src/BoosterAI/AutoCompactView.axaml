<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BoosterAI"
             x:Class="BoosterAI.AutoCompactView" x:DataType="local:AutoCompactViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{local:T compact.visual.locked}" TextWrapping="Wrap" IsVisible="{Binding !CanEdit}" />
    <StackPanel x:Name="CompactFields" Spacing="10" IsEnabled="{Binding CanEdit}" IsVisible="{Binding CanEdit}">
      <TextBlock Text="{local:T compact.visual.unsupported}" TextWrapping="Wrap" IsVisible="{Binding !Supported}" />
      <StackPanel Spacing="10" IsVisible="{Binding Supported}">
        <Grid ColumnDefinitions="*,*">
          <StackPanel Spacing="5" Margin="0,0,12,0">
            <TextBlock Classes="caption" Text="{local:T compact.model}" />
            <ComboBox x:Name="CompactModel" IsEditable="True" Text="{Binding Model}" ItemsSource="{Binding Models}" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T compact.model}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Classes="caption" Text="{local:T compact.profile}" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T compact.profile}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:CompactChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T compact.title}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="local:CompactChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox x:Name="CompactCustom" Text="{Binding Custom}" IsVisible="{Binding IsCustom}" Watermark="{local:T compact.custom.tokens}" AutomationProperties.Name="{local:T compact.custom.tokens}" />
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusLarge}" Padding="16" IsVisible="{Binding ShowBudget}">
          <StackPanel Spacing="8">
            <TextBlock Classes="caption" Text="{local:T compact.visual.budget}" />
            <WrapPanel><TextBlock Classes="display" Text="{Binding BudgetValue}" Margin="0,0,10,0" /><TextBlock Text="{Binding BudgetCapacity}" VerticalAlignment="Bottom" Margin="0,0,0,4" /></WrapPanel>
            <ProgressBar Value="{Binding BudgetPercent}" Maximum="100" Height="8" AutomationProperties.Name="{local:T compact.visual.budget}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding BudgetHint}" TextWrapping="Wrap" Classes="muted caption" />
        <TextBlock Classes="caption" Text="{Binding Validation}" TextWrapping="Wrap" />
        <Button x:Name="SaveCompact" Content="{local:T compact.save}" Click="OnSave" IsEnabled="{Binding CanSave}" Classes="secondary" HorizontalAlignment="Left" />
        <Expander Header="{local:T compact.visual.details}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="{local:T compact.context}" />
            <TextBox Text="{Binding Context}" Watermark="{local:T compact.context.unknown}" AutomationProperties.Name="{local:T compact.context}" />
            <TextBlock Text="{Binding ContextSource}" TextWrapping="Wrap" Classes="muted caption" />
            <TextBlock Classes="caption" Text="{Binding UnitExplanation}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{Binding Recommendation}" TextWrapping="Wrap" />
            <TextBlock Text="{local:T compact.tradeoff}" TextWrapping="Wrap" Classes="muted caption" />
          </StackPanel>
        </Expander>
        <TextBlock Text="{local:T compact.visual.apply}" TextWrapping="Wrap" Classes="muted caption" />
      </StackPanel>
      <Button x:Name="ResetCompact" Content="{local:T compact.visual.reset}" Click="OnReset" HorizontalAlignment="Left" ToolTip.Tip="{local:T compact.reset.detail}" />
      <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>

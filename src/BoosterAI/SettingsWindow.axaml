<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.SettingsWindow"
        x:DataType="local:MainViewModel"
        Title="{local:T settings.title}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="820" Height="784" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <!-- Columns: stripe 4 · gap 14 · name 220 · directory * · remove 36. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="28,22,28,20">

    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,20">
      <TextBlock Classes="title" Text="{local:T settings.projects.title}" />
      <TextBlock Classes="muted"
                 Text="{local:T settings.projects.hint}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="4,14,220,*,36" Margin="0,0,0,6" IsVisible="{Binding HasTabs}">
      <TextBlock Grid.Column="2" Classes="colhead" Text="{local:T col.tabname}" />
      <TextBlock Grid.Column="3" Classes="colhead" Text="{local:T col.directory}" />
    </Grid>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:TabViewModel">
            <Border Classes="row" Padding="0,6">
              <Grid ColumnDefinitions="4,14,220,*,36">
                <Button Grid.Column="0" Classes="stripe" Background="{Binding ColorBrush}"
                        Click="OnNextColor" ToolTip.Tip="{local:T color.change}" AutomationProperties.Name="{local:T color.change}" />
                <TextBox Grid.Column="2" Classes="inline name" Text="{Binding Name}" Watermark="{local:T col.tabname}"
                         Margin="-6,0,16,0" VerticalAlignment="Center" />
                <Grid Grid.Column="3" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                  <TextBox Grid.Column="0" Classes="inline path" Text="{Binding Directory}" Watermark="{Binding DirectoryHint}" />
                  <Button Grid.Column="1" Classes="icon" Click="OnBrowse" ToolTip.Tip="{local:T folder.pick}" AutomationProperties.Name="{local:T folder.pick}" Margin="4,0,0,0">
                    <Path Data="{StaticResource FolderIcon}" Width="15" Height="13" />
                  </Button>
                  <Button Grid.Column="2" Classes="icon" Click="OnOpenFolder" Margin="2,0,0,0"
                            ToolTip.Tip="{local:T folder.open.tip}" AutomationProperties.Name="{local:T folder.open.name}">
                      <Path Data="{StaticResource OpenExternalIcon}" Width="12" Height="12" />
                    </Button>
                </Grid>
                <Button Grid.Column="4" Classes="icon remove" Click="OnRemoveTab" ToolTip.Tip="{local:T project.remove}" AutomationProperties.Name="{local:T project.remove}"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Path Data="{StaticResource CloseIcon}" Width="10" Height="10" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="8" Margin="0,18,0,0">
      <TextBlock Classes="colhead" Text="{local:T colors.title}" />
      <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Classes="themes"
               Background="Transparent" AutomationProperties.Name="{local:T colors.name}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:ColorTheme">
            <StackPanel Spacing="6">
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="IBrush">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- Language and font size share one column grid so the combo boxes line up; hints wrap instead of clipping. -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,170,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,16,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhead" Text="{local:T language.title}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" Width="170"
                AutomationProperties.Name="{local:T language.name}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:LanguageChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Text="{local:T language.restart}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Margin="10,0,0,0" />
      <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhead" Text="{local:T zoom.title}" VerticalAlignment="Center" Margin="0,12,10,0" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ZoomChoices}" SelectedItem="{Binding SelectedZoom}" Width="170" Margin="0,12,0,0"
                AutomationProperties.Name="{local:T zoom.name}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:ZoomChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="{local:T zoom.hint}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Margin="10,12,0,0" />
      <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhead" Text="{local:T theme.title}" VerticalAlignment="Center" Margin="0,12,10,0" />
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AppearanceChoices}" SelectedItem="{Binding SelectedAppearance}" Width="170" Margin="0,12,0,0"
                AutomationProperties.Name="{local:T theme.name}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:ThemeChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted" Text="{local:T theme.hint}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Margin="10,12,0,0" />
      <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhead" Text="{local:T afterLaunch.title}" VerticalAlignment="Center" Margin="0,12,10,0" />
      <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AfterLaunchChoices}" SelectedItem="{Binding SelectedAfterLaunch}" Width="170" Margin="0,12,0,0"
                AutomationProperties.Name="{local:T afterLaunch.title}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:AfterLaunchChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="3" Grid.Column="2" Classes="muted" Text="{local:T afterLaunch.hint}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Margin="10,12,0,0" />
    </Grid>

    <WrapPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
      <CheckBox IsChecked="{Binding MinimizeToTray}" Content="{local:T settings.minimizeToTray}" Margin="0,0,24,0"
                ToolTip.Tip="{local:T settings.minimizeToTray.tip}" />
      <CheckBox IsChecked="{Binding Notifications}" Content="{local:T settings.notifications}" Margin="0,0,24,0"
                ToolTip.Tip="{local:T settings.notifications.tip}" />
      <CheckBox IsChecked="{Binding CheckForUpdates}" Content="{local:T settings.updates}" Margin="0,0,24,0"
                ToolTip.Tip="{Binding CheckForUpdatesTip}" />
      <CheckBox IsChecked="{Binding AutoUpdateClis}" Content="{local:T settings.cliUpdates}"
                ToolTip.Tip="{local:T settings.cliUpdates.tip}" />
    </WrapPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" ToolTip.Tip="{local:T settings.autoClear.tip}">
      <CheckBox IsChecked="{Binding AutoClearIdle}" Content="{local:T settings.autoClear}" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding AutoClearMinutes}" Minimum="1" Maximum="240" Increment="1" FormatString="0"
                     Width="110" IsEnabled="{Binding AutoClearIdle}" VerticalAlignment="Center"
                     AutomationProperties.Name="{local:T settings.autoClear.name}" />
      <TextBlock Text="{local:T settings.autoClear.minutes}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Setup check (#74): WSL and the AI CLIs where the tabs run; missing ones get a bar in the main window. -->
    <Grid Grid.Row="7" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
      <Button Grid.Column="0" Content="{local:T setup.check}" Click="OnCheckSetup" Padding="12,6" VerticalAlignment="Center"
              IsEnabled="{Binding !Setup.IsChecking}" ToolTip.Tip="{local:T setup.check.tip}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Setup.Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>

    <Grid Grid.Row="8" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0" Click="OnAddTab" Padding="12,8" AutomationProperties.Name="{local:T project.add}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource PlusIcon}" Width="11" Height="11" StrokeThickness="1.6" StrokeLineCap="Round"
                Stroke="{DynamicResource TextBrush}" Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Text="{local:T project.add}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Click="OnFindProjects" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center"
              Content="{local:T import.button}" ToolTip.Tip="{local:T import.button.tip}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="24,0" VerticalAlignment="Center">
        <TextBlock Classes="muted" Text="{local:T wsl.distro}" VerticalAlignment="Center" IsVisible="{Binding IsWindows}" />
        <TextBox Text="{Binding WslDistro}" Width="120" FontFamily="{StaticResource MonoFont}" FontSize="13"
                 IsVisible="{Binding IsWindows}" />
        <TextBlock Classes="muted" Text="{local:T terminal}" VerticalAlignment="Center" IsVisible="{Binding IsLinux}" />
        <ComboBox ItemsSource="{Binding LinuxTerminals}" SelectedItem="{Binding LinuxTerminal}" Width="170"
                  FontFamily="{StaticResource MonoFont}" FontSize="13" IsVisible="{Binding IsLinux}" />
      </StackPanel>
      <Button Grid.Column="3" Classes="accent" Content="{local:T done}" Click="OnDone" Padding="22,9" IsDefault="True" />
    </Grid>
  </Grid>
</Window>

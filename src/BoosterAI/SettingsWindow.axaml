<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterAI"
        x:Class="BoosterAI.SettingsWindow"
        x:DataType="local:MainViewModel"
        Title="{local:T settings.title}"
        Icon="avares://BoosterAI/Assets/boosterai.ico"
        Width="920" Height="700" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="28,20,28,20">

    <TabControl x:Name="TabsControl" Grid.Row="0" Classes="settings-tabs">

      <!-- Flik 1: Projekt -->
      <TabItem Header="{local:T settings.tab.projects}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="title" Text="{local:T settings.projects.title}" />
            <TextBlock Classes="muted" Text="{local:T settings.projects.hint}" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="4,14,220,*,36" Margin="0,0,0,6" IsVisible="{Binding HasTabs}">
            <TextBlock Grid.Column="2" Classes="colhead" Text="{local:T col.tabname}" />
            <TextBlock Grid.Column="3" Classes="colhead" Text="{local:T col.directory}" />
          </Grid>

          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Panel>
            <ItemsControl ItemsSource="{Binding Projects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TabViewModel">
                  <Border Classes="row" Padding="0,6">
                    <Grid ColumnDefinitions="4,14,220,*,36" RowDefinitions="Auto,Auto">
                      <Button Grid.Column="0" Classes="stripe" Background="{Binding ColorBrush}"
                              Click="OnNextColor" ToolTip.Tip="{local:T color.change}" AutomationProperties.Name="{local:T color.change}" />
                      <TextBox Grid.Column="2" Classes="inline name" Text="{Binding Name}" Watermark="{local:T col.tabname}"
                               Margin="-6,0,16,0" VerticalAlignment="Center" />
                      <Grid Grid.Column="3" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Classes="inline path" Text="{Binding Directory}" Watermark="{Binding DirectoryHint}" />
                        <Button Grid.Column="1" Classes="icon" Click="OnBrowse" ToolTip.Tip="{local:T folder.pick}" AutomationProperties.Name="{local:T folder.pick}" Margin="4,0,0,0">
                          <Path Data="{StaticResource FolderIcon}" Width="15" Height="13" />
                        </Button>
                        <Button Grid.Column="2" Classes="icon" Click="OnOpenFolder" Margin="2,0,0,0"
                                ToolTip.Tip="{local:T folder.open.tip}" AutomationProperties.Name="{local:T folder.open.name}">
                          <Path Data="{StaticResource OpenExternalIcon}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                      <Button Grid.Column="4" Classes="icon remove" Click="OnRemoveTab" ToolTip.Tip="{local:T project.remove}" AutomationProperties.Name="{local:T project.remove}"
                              IsEnabled="{Binding CanRemoveProject}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="{StaticResource CloseIcon}" Width="10" Height="10" />
                      </Button>
                      <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProjectRemovalHint}"
                                 IsVisible="{Binding !CanRemoveProject}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,2" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              <TextBlock Text="{local:T empty.text}" IsVisible="{Binding !HasTabs}" Classes="muted"
                         TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,32" />
            </Panel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Click="OnAddTab" Padding="12,8" AutomationProperties.Name="{local:T project.add}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource PlusIcon}" Width="11" Height="11" StrokeThickness="1.6" StrokeLineCap="Round"
                      Stroke="{DynamicResource TextBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{local:T project.add}" />
              </StackPanel>
            </Button>
            <Button Click="OnFindProjects" Padding="12,8" VerticalAlignment="Center"
                    Content="{local:T import.button}" ToolTip.Tip="{local:T import.button.tip}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Flik 2: Allmänt -->
      <TabItem Header="{local:T settings.tab.general}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
          <StackPanel Spacing="20">

            <!-- Fönster och aviseringar -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.behavior}" />

              <Grid ColumnDefinitions="140,170,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="colhead" Text="{local:T afterLaunch.title}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AfterLaunchChoices}" SelectedItem="{Binding SelectedAfterLaunch}" Width="170"
                          AutomationProperties.Name="{local:T afterLaunch.title}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AfterLaunchChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Classes="muted" Text="{local:T afterLaunch.hint}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,0,0,0" />
              </Grid>

              <StackPanel Spacing="6" Margin="0,4,0,0">
                <CheckBox IsChecked="{Binding MinimizeToTray}" Content="{local:T settings.minimizeToTray}"
                          ToolTip.Tip="{local:T settings.minimizeToTray.tip}" />
                <CheckBox IsChecked="{Binding Notifications}" Content="{local:T settings.notifications}"
                          ToolTip.Tip="{local:T settings.notifications.tip}" />
              </StackPanel>
            </StackPanel>

            <!-- Hitta projekt -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.findProjects}" />
              <TextBlock Classes="muted" Text="{local:T settings.findRoot.hint}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto,Auto" MaxWidth="560" HorizontalAlignment="Left">
                <TextBox Grid.Column="0" Text="{Binding ProjectSearchRoot}" Watermark="{Binding ProjectSearchRootDefault}"
                         FontFamily="{StaticResource MonoFont}" MinWidth="320" AutomationProperties.Name="{local:T settings.findRoot.name}" />
                <Button Grid.Column="1" Content="{local:T settings.findRoot.browse}" Click="OnBrowseSearchRoot" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="{local:T settings.findRoot.reset}" Click="OnResetSearchRoot" Margin="8,0,0,0"
                        IsEnabled="{Binding CanResetProjectSearchRoot}" />
              </Grid>
            </StackPanel>

            <!-- Automatisk rensning -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.autoClear}" />
              <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{local:T settings.autoClear.tip}">
                <CheckBox IsChecked="{Binding AutoClearIdle}" Content="{local:T settings.autoClear}" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AutoClearMinutes}" Minimum="1" Maximum="240" Increment="1" FormatString="0"
                               Width="110" IsEnabled="{Binding AutoClearIdle}" VerticalAlignment="Center"
                               AutomationProperties.Name="{local:T settings.autoClear.name}" />
                <TextBlock Text="{local:T settings.autoClear.minutes}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <!-- Uppdateringar -->
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.updates}" />
              <StackPanel Spacing="6">
                <CheckBox IsChecked="{Binding CheckForUpdates}" Content="{local:T settings.updates}"
                          ToolTip.Tip="{Binding CheckForUpdatesTip}" />
                <CheckBox IsChecked="{Binding AutoUpdateClis}" Content="{local:T settings.cliUpdates}"
                          ToolTip.Tip="{local:T settings.cliUpdates.tip}" />
              </StackPanel>
            </StackPanel>

            <!-- Miljö och terminal (Linux) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsLinux}">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.environment}" />

              <Grid ColumnDefinitions="140,170,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Classes="colhead" Text="{local:T terminal}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LinuxTerminals}" SelectedItem="{Binding LinuxTerminal}" Width="170"
                          FontFamily="{StaticResource MonoFont}" FontSize="13" />
              </Grid>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Optimization is split into independently scrollable pages. -->
      <TabItem Header="{local:T settings.tab.optimization}">
        <TabControl x:Name="OptimizationSections" Classes="optimization-sections" TabStripPlacement="Left"
                    Margin="0,16,0,0" SelectedIndex="0">
          <TabItem Header="{local:T settings.optimization.nav.usage}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0">
              <StackPanel Spacing="14" Margin="0,0,12,12">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="{local:T settings.optimization.usageTitle}" />
                    <Button Grid.Column="1" Classes="link" Content="{local:T settings.optimization.measurementDetails}" VerticalAlignment="Center">
                      <Button.Flyout>
                        <Flyout Placement="Bottom">
                          <StackPanel Spacing="10" MaxWidth="400">
                            <TextBlock Text="{local:T settings.optimization.usageSource}" TextWrapping="Wrap" />
                            <TextBlock Text="{local:T settings.optimization.usageHint}" Classes="muted" TextWrapping="Wrap" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <TextBlock Classes="muted" Text="{local:T settings.optimization.usageIntro}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="12" IsVisible="{Binding Optimization.IsWindows}">
                  <TextBlock Classes="muted" Text="{Binding Optimization.MemoryScaleText}" FontSize="12" TextWrapping="Wrap" />

                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{local:T settings.optimization.now}" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Optimization.MemoryCurrentValue}" FontSize="30" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding Optimization.MemoryCurrentText}" IsVisible="{Binding !Optimization.HasCurrentMemory}"
                               Classes="muted" TextWrapping="Wrap" />
                    <Border Classes="memory-track">
                      <local:SliderRangePanel LowerFraction="0" UpperFraction="{Binding Optimization.MemoryCurrentFraction}"
                                              Inset="0" IsVisible="{Binding Optimization.HasCurrentMemory}" IsHitTestVisible="False">
                        <Border Background="{DynamicResource LinkBrush}" CornerRadius="4" />
                      </local:SliderRangePanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{local:T settings.optimization.history}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{local:T settings.optimization.averageMarker}" Classes="muted" FontSize="12" />
                    </Grid>
                    <Border Classes="memory-track">
                      <Panel IsHitTestVisible="False" IsVisible="{Binding Optimization.HasMemoryHistory}">
                        <local:SliderRangePanel LowerFraction="{Binding Optimization.MemoryLowerFraction}"
                                                UpperFraction="{Binding Optimization.MemoryUpperFraction}" Inset="0">
                          <Border Background="{DynamicResource LinkBrush}" Opacity="0.25" />
                          <Border BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" CornerRadius="3" />
                        </local:SliderRangePanel>
                        <local:SliderMarkerPanel Fraction="{Binding Optimization.MemoryAverageFraction}" Inset="0">
                          <Border Width="3" Height="28" Background="{DynamicResource TextBrush}" />
                        </local:SliderMarkerPanel>
                      </Panel>
                    </Border>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                      <Border Grid.Column="0" Classes="memory-stat">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="muted" Text="{local:T settings.optimization.minimum}" FontSize="12" />
                          <TextBlock Text="{Binding Optimization.MemoryMinimumValue}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="memory-stat">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="muted" Text="{local:T settings.optimization.average}" FontSize="12" />
                          <TextBlock Text="{Binding Optimization.MemoryAverageValue}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="memory-stat">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="muted" Text="{local:T settings.optimization.maximum}" FontSize="12" />
                          <TextBlock Text="{Binding Optimization.MemoryMaximumValue}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Optimization.MemoryPeriodText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{local:T settings.optimization.suggested}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Optimization.RecommendationValue}" Foreground="{DynamicResource RecommendedBrush}" FontSize="12" />
                    </Grid>
                    <Border Classes="memory-track">
                      <local:SliderRangePanel LowerFraction="{Binding Optimization.SuggestedLowerFraction}"
                                              UpperFraction="{Binding Optimization.SuggestedUpperFraction}" Inset="0" IsHitTestVisible="False">
                        <Border Background="{DynamicResource RecommendedBrush}" Opacity="0.22" />
                        <Border BorderBrush="{DynamicResource RecommendedBrush}" BorderThickness="2" CornerRadius="3" />
                      </local:SliderRangePanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{local:T settings.optimization.savedCap}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Optimization.MemoryCapText}" FontSize="12" />
                    </Grid>
                    <Border Classes="memory-track">
                      <local:SliderRangePanel LowerFraction="0" UpperFraction="{Binding Optimization.MemoryCapFraction}" Inset="0" IsHitTestVisible="False">
                        <Border Background="{DynamicResource FaintBrush}" Opacity="0.3" />
                        <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="0,0,3,0" />
                      </local:SliderRangePanel>
                    </Border>
                    <Panel Height="18" IsHitTestVisible="False">
                      <local:SliderMarkerPanel Fraction="0" Inset="0"><TextBlock Text="0 GB" Classes="memory-axis" /></local:SliderMarkerPanel>
                      <local:SliderMarkerPanel Fraction="0.25" Inset="0"><TextBlock Text="{Binding Optimization.MemoryQuarterText}" Classes="memory-axis" /></local:SliderMarkerPanel>
                      <local:SliderMarkerPanel Fraction="0.5" Inset="0"><TextBlock Text="{Binding Optimization.MemoryHalfText}" Classes="memory-axis" /></local:SliderMarkerPanel>
                      <local:SliderMarkerPanel Fraction="0.75" Inset="0"><TextBlock Text="{Binding Optimization.MemoryThreeQuarterText}" Classes="memory-axis" /></local:SliderMarkerPanel>
                      <local:SliderMarkerPanel Fraction="1" Inset="0"><TextBlock Text="{Binding Optimization.TotalMemoryText}" Classes="memory-axis" /></local:SliderMarkerPanel>
                    </Panel>
                    <TextBlock Text="{local:T settings.optimization.outsideScale}" IsVisible="{Binding Optimization.MemoryOutsideScale}"
                               Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Content="{local:T settings.optimization.editCap}" Click="OnShowMemoryLimit" HorizontalAlignment="Left" Padding="14,8" />
                </StackPanel>
                <TextBlock Text="{local:T settings.optimization.linuxNote}" IsVisible="{Binding Optimization.IsLinux}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{local:T settings.optimization.nav.limit}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0">
              <StackPanel Spacing="12" Margin="0,0,12,12">
                <TextBlock Classes="title" Text="{local:T settings.optimization.nav.limit}" />
                <TextBlock Classes="muted" Text="{local:T settings.optimization.hint}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                  <TextBlock Classes="colhead" Text="{local:T settings.optimization.totalRam}" />
                  <TextBlock Grid.Column="1" Text="{Binding Optimization.TotalMemoryText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Classes="colhead" Text="{local:T settings.optimization.currentConfig}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Optimization.CurrentConfigText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
              <!-- Editing stays separate from observed usage. -->
              <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding Optimization.IsWindows}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="colhead" Text="{local:T settings.optimization.memorySlider}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Optimization.SliderMemoryText}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Both bracket boundaries meet the slider track and stay visible behind its thumb. -->
                <Panel Margin="0,4,0,0">
                  <local:SliderRangePanel LowerFraction="{Binding Optimization.RecommendationLowerFraction}"
                                          UpperFraction="{Binding Optimization.RecommendationUpperFraction}"
                                          Inset="10" Height="14" VerticalAlignment="Center" Margin="0,-16,0,0"
                                          IsHitTestVisible="False">
                    <Border Background="{DynamicResource RecommendedBrush}" Opacity="0.18" />
                    <Border BorderBrush="{DynamicResource RecommendedBrush}" BorderThickness="2,0,2,2" />
                  </local:SliderRangePanel>
                  <Slider Minimum="{Binding Optimization.MinMemoryGb}" Maximum="{Binding Optimization.MaxMemoryGb}"
                          Value="{Binding Optimization.SliderMemoryGb, Mode=TwoWay}"
                          TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{local:T settings.optimization.memorySlider}"
                          AutomationProperties.HelpText="{Binding Optimization.RecommendationText}" />
                </Panel>
                <local:SliderMarkerPanel Fraction="{Binding Optimization.RecommendationCentreFraction}" Inset="10"
                                         IsHitTestVisible="False" Margin="0,-10,0,4">
                  <TextBlock Text="{Binding Optimization.RecommendationText}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource RecommendedBrush}" />
                </local:SliderMarkerPanel>

                <TextBlock Classes="muted" FontSize="12.5" Text="{local:T settings.optimization.rangeHint}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{local:T settings.optimization.lowerHint}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{local:T settings.optimization.upperHint}" TextWrapping="Wrap" />
                <Button Classes="link" Click="OnUseRecommendedMemory" HorizontalAlignment="Left"
                        Content="{local:T settings.optimization.useRecommendation}"
                        ToolTip.Tip="{local:T settings.optimization.useRecommendation}" />

                <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Classes="accent" Content="{local:T settings.optimization.save}" Click="OnSaveOptimization"
                          IsEnabled="{Binding Optimization.CanSave}" Padding="14,7" Margin="0,0,8,8" />
                  <Button Content="{local:T settings.optimization.restartWsl}" Click="OnRestartWsl" Padding="14,7" Margin="0,0,0,8" ToolTip.Tip="{local:T settings.optimization.restartWsl.tip}" />
                </WrapPanel>

                <!-- Feedback from explicit save/restart. -->
                <TextBlock Text="{Binding Optimization.StatusMessage}" IsVisible="{Binding Optimization.HasStatusMessage}"
                           Foreground="{Binding Optimization.StatusColorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" />
              </StackPanel>


                <Button Classes="link" Content="{local:T settings.optimization.showUsage}" Click="OnShowMemoryUsage" HorizontalAlignment="Left" />
                <TextBlock Classes="muted" Text="{local:T settings.optimization.linuxNote}" IsVisible="{Binding Optimization.IsLinux}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{local:T settings.optimization.nav.environment}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0">
              <StackPanel Spacing="16" Margin="0,0,12,12">
                <TextBlock Classes="title" Text="{local:T settings.optimization.nav.environment}" />
                <TextBlock Classes="muted" Text="{local:T settings.optimization.environmentIntro}" TextWrapping="Wrap" />
                <StackPanel Spacing="8" IsVisible="{Binding Optimization.IsWindows}">
                  <TextBlock Classes="colhead" Text="{local:T wsl.distro}" />
                  <TextBox Text="{Binding WslDistro}" HorizontalAlignment="Left" Width="300"
                           FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{local:T wsl.distro}" />
                </StackPanel>
                <StackPanel Spacing="12" IsVisible="{Binding Optimization.IsWindows}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{local:T wsl.info.status}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Setup.WslInstallationStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{local:T wsl.info.checkedDistro}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Setup.CheckedWslDistro}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{local:T wsl.info.distros}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Setup.InstalledWslDistros}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="muted" Text="{local:T setup.environment.windows}" IsVisible="{Binding Optimization.IsWindows}" TextWrapping="Wrap" />
                <TextBlock Text="{local:T setup.environment.linux}" IsVisible="{Binding Optimization.IsLinux}" TextWrapping="Wrap" />
                <Button Classes="link" Content="{local:T setup.environment.agents}" Click="OnShowEnvironmentAgents" HorizontalAlignment="Left" />
                <TextBlock Classes="muted" Text="{local:T settings.optimization.linuxNote}" IsVisible="{Binding Optimization.IsLinux}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{local:T compact.title}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0">
              <StackPanel Spacing="10" Margin="0,0,12,12">
                <TextBlock Classes="title" Text="{local:T compact.global.title}" TextWrapping="Wrap" />
                <TextBlock Text="{local:T compact.guide.benefit}" TextWrapping="Wrap" />
                <local:CompactBenefitView />
                <ComboBox x:Name="CompactGlobalMode" ItemsSource="{Binding CompactGlobalModes}" SelectedItem="{Binding SelectedCompactMode}"
                          HorizontalAlignment="Left" MaxWidth="400" AutomationProperties.Name="{local:T compact.global.title}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="local:CompactChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding CompactModeExplanation}" TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Classes="muted" Text="{local:T compact.guide.applies}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <local:CompactAutoGuideView />
                <Button Classes="link" Content="{local:T compact.global.advanced}" Click="OnShowCompactAgents" HorizontalAlignment="Left" />
                <Expander HorizontalAlignment="Stretch">
                  <Expander.Header><TextBlock Text="{local:T compact.guide.details}" TextWrapping="Wrap" /></Expander.Header>
                  <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="{local:T compact.global.modes}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{local:T compact.global.auto.profile}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding CompactMetadataStatus}" IsVisible="{Binding CompactIsAuto}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{local:T compact.global.auto.fallback}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{local:T compact.global.applies}" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- Flik 4: Utseende -->
      <TabItem Header="{local:T settings.tab.appearance}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
          <StackPanel Spacing="24">

            <!-- Tema och språk -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionhead" Text="{local:T settings.section.appearanceLanguage}" />

              <Grid ColumnDefinitions="140,170,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhead" Text="{local:T theme.title}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AppearanceChoices}" SelectedItem="{Binding SelectedAppearance}" Width="170"
                          AutomationProperties.Name="{local:T theme.name}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ThemeChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Text="{local:T theme.hint}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,0,0,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhead" Text="{local:T language.title}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" Width="170" Margin="0,12,0,0"
                          AutomationProperties.Name="{local:T language.name}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:LanguageChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="{local:T language.restart}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,12,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhead" Text="{local:T zoom.title}" VerticalAlignment="Center" Margin="0,12,14,0" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ZoomChoices}" SelectedItem="{Binding SelectedZoom}" Width="170" Margin="0,12,0,0"
                          AutomationProperties.Name="{local:T zoom.name}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ZoomChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted" Text="{local:T zoom.hint}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,12,0,0" />
              </Grid>
            </StackPanel>

            <!-- Flikfärger -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionhead" Text="{local:T colors.title}" />
              <TextBlock Classes="muted" Text="{local:T colors.hint}" Margin="0,0,0,4" />
              <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Classes="themes"
                       Background="Transparent" AutomationProperties.Name="{local:T colors.name}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ColorTheme">
                    <StackPanel Spacing="6">
                      <ItemsControl ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="IBrush">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Agent pages stay mounted: switching sections never recreates editable controls. -->
      <TabItem x:Name="AgentsTab" Header="{local:T settings.tab.agents}">
        <Grid RowDefinitions="*,Auto,Auto" Margin="0,16,0,0">
          <Grid ColumnDefinitions="136,*">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
              <Button Content="{local:T agents.overview.all}" Click="OnAgentOverview" Classes="agent-nav" Classes.chosen="{Binding Setup.IsAgentOverview}" HorizontalAlignment="Stretch" />
              <ListBox x:Name="AgentSections" Classes="agent-sections" ItemsSource="{Binding Setup.Agents}"
                       SelectedItem="{Binding Setup.SelectedAgent}" Background="Transparent" BorderThickness="0"
                       AutomationProperties.Name="{local:T settings.tab.agents}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:AgentInfo">
                    <StackPanel Orientation="Horizontal" Spacing="8"><local:AgentIcon Cli="{Binding Cli}" Width="20" Height="20" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            </ScrollViewer>
            <Panel Grid.Column="1" Margin="16,0,0,0">
              <ScrollViewer IsVisible="{Binding Setup.IsAgentOverview}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,0,12,12">
                  <TextBlock Classes="title" Text="{local:T agents.overview.title}" />
                  <TextBlock Classes="muted" Text="{local:T agents.overview.hint}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Setup.Agents}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:AgentInfo">
                        <Button Classes="agent-card" Click="OnOpenAgent" Width="198" Margin="0,0,10,10" AutomationProperties.Name="{Binding DisplayName}">
                          <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10"><local:AgentIcon Cli="{Binding Cli}" Width="28" Height="28" /><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="#28A56A" IsVisible="{Binding IsInstalled}" /><TextBlock Text="{Binding StatusText}" FontSize="12" /><TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="12" /></StackPanel>
                            <TextBlock Text="{Binding CurrentModeText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Advice.CardStatus}" IsVisible="{Binding Advice.IsSupported}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <ItemsControl ItemsSource="{Binding Setup.Agents}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:AgentInfo">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSelected}">
                      <StackPanel Spacing="16" Margin="0,0,12,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <local:AgentIcon Cli="{Binding Cli}" Width="36" Height="36" Margin="0,0,12,0" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="title" Text="{Binding DisplayName}" />
                            <WrapPanel IsVisible="{Binding IsInstalled}"><TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,10,0" /><TextBlock Text="{local:T agents.version}" Classes="muted" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding VersionText}" FontSize="12" /></WrapPanel>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="accent" Content="{Binding InstallButtonText}" Click="OnInstallAgent"
                                  ToolTip.Tip="{Binding InstallTip}" IsVisible="{Binding !IsInstalled}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <WrapPanel IsVisible="{Binding IsInstalled}">
                          <Button Classes="agent-nav" Classes.chosen="{Binding IsOverview}" Content="{local:T agents.section.overview}" Tag="0" Click="OnAgentSection" Margin="0,0,6,0" />
                            <Button Classes="agent-nav" Classes.chosen="{Binding IsPermissions}" Content="{local:T agents.section.permissions}" Tag="1" Click="OnAgentSection" Margin="0,0,6,0" />
                            <Button Classes="agent-nav" Classes.chosen="{Binding IsContext}" Content="{local:T agents.section.context}" Tag="2" Click="OnAgentSection" />
                          </WrapPanel>
                        <Panel IsVisible="{Binding ShowModelAdvice}"><local:SettingsModelAdviceView DataContext="{Binding Advice}" /></Panel>

                        <StackPanel Spacing="16" IsVisible="{Binding IsInstalled}">
                          <StackPanel Spacing="14" IsVisible="{Binding IsOverview}">
                            <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                            <Button Classes="agent-card" Click="OnAgentSection" Tag="1" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{local:T agents.section.permissions}" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentModeText}" Classes="muted" /></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="25" VerticalAlignment="Center" /></Grid>
                            </Button>
                            <Button Classes="agent-card" Click="OnAgentSection" Tag="2" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{local:T agents.section.context}" FontWeight="SemiBold" /><TextBlock Text="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectedCompactMode.Label}" Classes="muted" /></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="25" VerticalAlignment="Center" /></Grid>
                            </Button>
                            <Button Content="{Binding InstallButtonText}" Click="OnInstallAgent" ToolTip.Tip="{Binding InstallTip}" HorizontalAlignment="Left" />
                            <Expander Header="{local:T agents.details.installation}" HorizontalAlignment="Stretch">
                              <StackPanel Spacing="8"><TextBlock Text="{local:T agents.intro}" TextWrapping="Wrap" FontSize="12" /><TextBlock Text="{Binding UpdateInfo}" TextWrapping="Wrap" FontSize="12" /></StackPanel>
                            </Expander>
                          </StackPanel>
                          <StackPanel Spacing="12" IsVisible="{Binding IsPermissions}">
                            <TextBlock Text="{local:T agents.alias.what}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                            <Border Classes="agent-group">
                              <StackPanel Spacing="6">
                                <WrapPanel><TextBlock Text="{local:T agents.alias.current}" FontWeight="SemiBold" Margin="0,0,8,0" /><TextBlock Text="{Binding CurrentModeText}" /></WrapPanel>
                                <ScrollViewer MaxHeight="100" IsVisible="{Binding HasCurrentAliasCommand}" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Text="{Binding CurrentAliasCommand}" Classes="path" TextWrapping="Wrap" FontSize="12" /></ScrollViewer>
                                <TextBlock Text="{local:T agents.alias.truncated}" IsVisible="{Binding DefinitionTruncated}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{local:T agents.alias.definitionMissing}" IsVisible="{Binding MissingDefinition}" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding CurrentAliasExplanation}" TextWrapping="Wrap" FontSize="12" />
                              </StackPanel>
                            </Border>
                            <StackPanel Spacing="6">
                              <TextBlock Text="{local:T agents.alias.choose}" FontWeight="SemiBold" />
                              <ComboBox ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanSelectMode}" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T agents.alias.choose}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:AgentModeChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBlock Text="{Binding AliasRecommendation}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <Border Background="#20DD7536" CornerRadius="6" Padding="10" IsVisible="{Binding IsYolo}"><TextBlock Text="{local:T agents.permissions.warning}" TextWrapping="Wrap" FontWeight="SemiBold" /></Border>
                            <TextBlock Text="{Binding ModeExplanation}" TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Spacing="5" IsVisible="{Binding HasPresetPreview}">
                              <TextBlock Text="{local:T agents.alias.preview}" FontWeight="SemiBold" FontSize="12" />
                              <SelectableTextBlock Text="{Binding ModePreview}" Classes="path" TextWrapping="Wrap" FontSize="12" />
                              <TextBlock Text="{Binding ModePreviewEffect}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <Button Classes="accent" Content="{local:T agents.mode.apply}" Click="OnApplyAgentMode" IsEnabled="{Binding CanApply}" HorizontalAlignment="Left" />
                            <TextBlock Text="{local:T agents.alias.scope}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                          </StackPanel>
                          <StackPanel Spacing="12" IsVisible="{Binding IsContext}">
                            <WrapPanel><TextBlock Text="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectedCompactMode.Label}" FontWeight="SemiBold" Margin="0,6,12,6" /><Button Classes="link" Content="{local:T agents.context.global}" Click="OnAgentCompactSettings" /></WrapPanel>
                            <local:AutoCompactView DataContext="{Binding Compact}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Setup.CheckNotice}" Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Fönsterfot: endast Klar-knappen, högerställd -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Button Classes="accent" Content="{local:T done}" Click="OnDone" Padding="24,9" HorizontalAlignment="Right" IsDefault="True" />
    </Grid>

  </Grid>
</Window>

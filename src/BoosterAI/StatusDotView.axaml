<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BoosterAI"
             x:Class="BoosterAI.StatusDotView" x:DataType="local:TabViewModel"
             VerticalAlignment="Center" IsHitTestVisible="False">
  <!-- The tab's status dot (#222, #227), shared by the status column and the status popup so both speak the same shapes:
       working is filled with a pulsing halo, waiting a ring, a warning or error a diamond, anything else a plain dot.
       16 px square holds the largest halo, so no parent clips it. How hard the tab works (#286, CpuLevel) sets the pulse's
       pace and strength, or with animations off the still halo's size and strength (DotPulse). -->
  <Panel Classes="status-dot" Width="16" Height="16">
    <Ellipse Classes="status-pulse" Classes.low="{Binding StatusLevelLow}" Classes.medium="{Binding StatusLevelMedium}"
             Classes.high="{Binding StatusLevelHigh}" Width="9" Height="9" Fill="{Binding StatusBrush}" IsVisible="{Binding StatusPulse}">
      <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse Width="{Binding StatusDotPulse.HaloSize}" Height="{Binding StatusDotPulse.HaloSize}" Fill="{Binding StatusBrush}" Opacity="{Binding StatusDotPulse.HaloOpacity}" IsVisible="{Binding StatusHalo}" />
    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" IsVisible="{Binding StatusDotFilled}" />
    <Ellipse Width="9" Height="9" Stroke="{Binding StatusBrush}" StrokeThickness="2" IsVisible="{Binding StatusDotRing}" />
    <Path Width="10" Height="10" Stretch="Fill" Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{Binding StatusBrush}" IsVisible="{Binding StatusDotDiamond}" />
  </Panel>
</UserControl>

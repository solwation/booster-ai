<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterStart"
        x:Class="BoosterStart.MainWindow"
        x:DataType="local:MainViewModel"
        Title="BoosterStart"
        Icon="avares://BoosterStart/Assets/boosterstart.ico"
        Width="960" Height="560" MinWidth="780" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <!--
    Today's choices only: which tabs, and the AI, model and /orkester for each.
    Names and directories are edited in Settings. The header and the rows share
    one column layout (stripe 4 · gap 14 · check 36 · name * · llm 132 · model 236 · orkester 120)
    inside the same padding, so labels sit exactly over their fields.
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,22,28,20">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <Image Grid.Column="0" Source="avares://BoosterStart/Assets/boosterstart.png" Width="40" Height="40"
             VerticalAlignment="Center" Margin="0,0,14,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="title" Text="BoosterStart" />
        <TextBlock Classes="muted" Text="Välj AI och modell för dagens arbete och starta." />
      </StackPanel>
      <Button Grid.Column="2" Click="OnSettings" Padding="12,8" AutomationProperties.Name="Inställningar" VerticalAlignment="Center"
              ToolTip.Tip="Vilka projekt som öppnas, WSL och terminal">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource GearIcon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5"
                StrokeLineCap="Round" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Inställningar" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="4,14,36,*,132,236,120" Margin="0,0,0,6" IsVisible="{Binding HasTabs}">
      <TextBlock Grid.Column="2" Classes="colhead" Text="Med" />
      <TextBlock Grid.Column="3" Classes="colhead" Text="Projekt" />
      <TextBlock Grid.Column="4" Classes="colhead" Text="LLM" />
      <TextBlock Grid.Column="5" Classes="colhead" Text="Modell" />
      <TextBlock Grid.Column="6" Classes="colhead" Text="Orkester" Margin="16,0,0,0" />
    </Grid>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <Panel>
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TabViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="4,14,36,*,132,236,120">
                  <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="2" />

                  <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"
                            MinWidth="0" ToolTip.Tip="Öppna den här fliken" />

                  <StackPanel Grid.Column="3" Opacity="{Binding RowOpacity}" Margin="0,0,16,0"
                              VerticalAlignment="Center" Spacing="3">
                    <TextBlock Classes="name" Text="{Binding Name}" />
                    <TextBlock Classes="path" Text="{Binding Directory}" />
                  </StackPanel>

                  <ComboBox Grid.Column="4" Classes="field" ItemsSource="{Binding Llms}" SelectedItem="{Binding Llm}"
                            Margin="0,0,12,0" Opacity="{Binding RowOpacity}" />
                  <ComboBox Grid.Column="5" Classes="field" IsEditable="True" ItemsSource="{Binding Models}"
                            Text="{Binding Model}" IsEnabled="{Binding IsAi}" Opacity="{Binding RowOpacity}"
                            ToolTip.Tip="Välj i listan eller skriv ett eget modell-id" />

                  <Panel Grid.Column="6" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                    <ToggleSwitch IsChecked="{Binding Orkester}" IsVisible="{Binding CanOrkester}"
                                  OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0"
                                  ToolTip.Tip="Skicka /orkester som första prompt" />
                    <Button Classes="link" IsVisible="{Binding CanInstallOrkester}" Click="OnInstallOrkester"
                            AutomationProperties.Name="Installera med AI"
                            ToolTip.Tip="Öppnar en flik där vald AI installerar orkestern i projektet">
                      <TextBlock Text="Installera med AI" />
                    </Button>
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Margin="0,40">
          <TextBlock Classes="muted" Text="Inga projekt ännu. Lägg till de kataloger du brukar jobba i."
                     HorizontalAlignment="Center" />
          <Button Content="Lägg till projekt" Click="OnSettings" HorizontalAlignment="Center" Classes="accent" />
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Margin="0,0,20,0" Classes.muted="{Binding !StatusIsError}"
                 Foreground="{Binding StatusIsError, Converter={x:Static local:Converters.ErrorBrush}}" />
      <Button Grid.Column="1" Classes="boost" Click="OnLaunch" AutomationProperties.Name="{Binding LaunchLabel}" IsDefault="True" IsEnabled="{Binding CanLaunch}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Path Data="{StaticResource BoltIcon}" Fill="White" Width="12" Height="15" Stretch="Uniform"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding LaunchLabel}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>

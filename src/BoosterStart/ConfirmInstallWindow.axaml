<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BoosterStart"
        x:Class="BoosterStart.ConfirmInstallWindow"
        x:DataType="local:TabViewModel"
        Title="{local:T confirm.title}"
        Icon="avares://BoosterStart/Assets/boosterstart.ico"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="28,24,28,22" Spacing="14">
    <TextBlock Classes="title" FontSize="20" TextWrapping="Wrap"
               Text="{Binding InstallTitle}" />

    <TextBlock TextWrapping="Wrap" LineHeight="21"
               Text="{local:T confirm.intro}" />

    <StackPanel Spacing="6">
      <TextBlock Classes="muted" Text="{local:T confirm.addsTo}" />
      <Border Background="{DynamicResource RowHoverBrush}" CornerRadius="6" Padding="10,7">
        <TextBlock Classes="path" Text="{Binding Directory}" Foreground="{DynamicResource TextBrush}" />
      </Border>
      <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="20"
                 Text="{local:T confirm.addsDetail}" />
    </StackPanel>

    <TextBlock TextWrapping="Wrap" LineHeight="21"
               Text="{Binding InstallSummary}" />

    <Button Classes="link" Click="OnReadMore" HorizontalAlignment="Left"
            AutomationProperties.Name="{local:T confirm.readmore.name}">
      <TextBlock Text="{local:T confirm.readmore}" />
    </Button>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
      <Button Content="{local:T cancel}" Click="OnCancel" IsCancel="True" Padding="18,8" />
      <Button Classes="accent" Click="OnConfirm" IsDefault="True" Padding="18,8"
              Content="{Binding InstallButton}" />
    </StackPanel>
  </StackPanel>
</Window>

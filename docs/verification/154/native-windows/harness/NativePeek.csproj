<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <BoosterAssembly Condition="'$(BoosterAssembly)' == ''">$(MSBuildThisFileDirectory)../../../../../src/BoosterAI/bin/Release/net10.0/BoosterAI.dll</BoosterAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BoosterAI"><HintPath>$(BoosterAssembly)</HintPath></Reference>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>
</Project>
